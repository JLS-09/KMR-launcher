<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        x:Class="KMRLauncherMvvm.Views.InstallMods.InstallProgressWindow"
        x:DataType="vm:InstallProgressViewModel"
        Background="#1F1F20"
        Foreground="{DynamicResource PrimaryText}"
        Width="700" Height="600"
        Title="Installing mods">

    <Design.DataContext>
        <vm:InstallProgressViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Read-only list: hide the ListBox selection/hover look -->
        <Style Selector="ListBox.progress-list">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.progress-list > ListBoxItem">
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="Margin" Value="0 0 0 4" />
            <Setter Property="Background" Value="{DynamicResource SideBarBackground}" />
        </Style>
        <Style
            Selector="ListBox.progress-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SideBarBackground}" />
        </Style>
        <Style
            Selector="ListBox.progress-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SideBarBackground}" />
        </Style>
        <Style Selector="TextBlock.state">
            <Setter Property="FontFamily" Value="{DynamicResource SpaceMonoBold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        </Style>
    </Window.Styles>

    <Grid Margin="32" RowDefinitions="Auto Auto Auto * Auto" RowSpacing="16">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="INSTALLING MODS" FontSize="30" FontFamily="{DynamicResource SpaceMonoBold}"
                       LetterSpacing="1.5" />
            <Rectangle Height="4" Fill="{DynamicResource PrimaryRed}" Width="80" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Overall progress -->
        <Border Grid.Row="1" Background="#1B1B1C" BorderBrush="{DynamicResource PrimaryRed}"
                BorderThickness="2 0 0 0" Padding="24 16">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="* Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryText}"
                                   FontFamily="{DynamicResource SpaceMonoBold}" LetterSpacing="2" FontSize="13" />
                        <TextBlock Text="{Binding OverallText}" FontFamily="{DynamicResource Inter}" FontSize="15"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource PrimaryRed}" FontSize="24"
                               FontFamily="{DynamicResource SpaceGrotesk}" FontWeight="Bold" LetterSpacing="2" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="1" Height="4" Foreground="{DynamicResource PrimaryRed}"
                             Value="{Binding OverallProgress}" />
            </StackPanel>
        </Border>

        <!-- What went wrong. Bounded height, so the ScrollViewer is fine. -->
        <Border Grid.Row="2" IsVisible="{Binding HasError}" Padding="12 8"
                Background="{DynamicResource SideBarBackground}"
                BorderBrush="{DynamicResource PrimaryRed}" BorderThickness="2 0 0 0">
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource PrimaryRed}" />
            </ScrollViewer>
        </Border>

        <!-- One row per mod (ListBox virtualizes its rows) -->
        <ListBox Grid.Row="3" Classes="progress-list" ItemsSource="{Binding Rows}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModProgressRowViewModel">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="* Auto" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Identifier}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Version}" Foreground="{DynamicResource SecondaryText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="state" Text="{Binding StateText}"
                                       IsVisible="{Binding !IsFailed}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="state" Text="{Binding StateText}"
                                       Foreground="{DynamicResource PrimaryRed}"
                                       IsVisible="{Binding IsFailed}" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="1" Height="3" Foreground="{DynamicResource PrimaryRed}"
                                     Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" />
                        <TextBlock Text="{Binding DetailText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="4">
            <Button Classes="Secondary" Padding="24 12" HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}">
                <TextBlock Text="CANCEL" FontFamily="{DynamicResource SpaceGrotesk}"
                           FontWeight="Bold" LetterSpacing="1.5" FontSize="16" />
            </Button>
            <Button Classes="Primary" Padding="24 12" HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}" IsVisible="{Binding IsFinished}">
                <TextBlock Text="CLOSE" FontFamily="{DynamicResource SpaceGrotesk}"
                           FontWeight="Bold" LetterSpacing="1.5" FontSize="16" />
            </Button>
        </DockPanel>
    </Grid>
</Window>

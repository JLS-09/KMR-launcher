<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
             xmlns:models="clr-namespace:KMRLauncherMvvm.Models"
             x:DataType="vm:InstallModsSelectInstanceStepViewModel"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             Background="#1F1F20"
             Foreground="{DynamicResource PrimaryText}"
             x:Class="KMRLauncherMvvm.Views.InstallMods.InstallModsSelectInstanceStepView">

    <UserControl.Styles>
        <Style Selector="ComboBox">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="ComboBox:pointerover /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryRed}" />
            <Setter Property="Background" Value="Black" />
        </Style>

        <Style Selector="ComboBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Black" />
        </Style>

        <Style Selector="ComboBox:pressed /template/ Border">
            <Setter Property="Background" Value="Black" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="32 0 32 0" RowDefinitions="Auto Auto *" RowSpacing="32">
        <!-- Row 0 was the progress bar; it lives in InstallModsWindow now -->
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="TARGET INSTANCE" LetterSpacing="1" Foreground="{DynamicResource SecondaryText}"
                       FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
            <ComboBox Background="Black" HorizontalAlignment="Stretch" Height="48"
                      ItemsSource="{Binding Instances}"
                      SelectedItem="{Binding InstallModsData.SelectedInstance}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Problems the resolver couldn't solve; they block Next. Bounded height, so the ScrollViewer is fine. -->
            <Border IsVisible="{Binding HasProblems}" Margin="0 8 0 0" Padding="12 8"
                    Background="{DynamicResource SideBarBackground}"
                    BorderBrush="{DynamicResource PrimaryRed}" BorderThickness="2 0 0 0">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InstallModsData.Problems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ResolutionProblem">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0 2"
                                           Foreground="{DynamicResource PrimaryRed}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2" RowDefinitions="Auto *" RowSpacing="8">
            <Grid Grid.Row="0" ColumnDefinitions="50 *" ColumnSpacing="24">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="CHANGE" LetterSpacing="1"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="SELECTED MODS" LetterSpacing="1"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{Binding InstallModsData.FinalModList}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="50 *" ColumnSpacing="24">
                                <TextBlock Grid.Column="0" Text="Install" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Version.Id}" />
                                    <TextBlock Text="{Binding ReasonForAction}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
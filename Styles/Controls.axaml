<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KMRLauncherMvvm.Controls">
    <!-- Shared controls of the new design, with the sizes and colours from the mockups.
         Use the classes below on the normal controls. -->
    <Design.PreviewWith>
        <Border Padding="24" Background="{DynamicResource Background}" Width="560">
            <StackPanel Spacing="16">
                <TextBlock Classes="h1" Text="Heading" />
                <TextBlock Classes="label" Text="SECTION LABEL" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Content="Review changes" />
                    <Button Classes="secondary" Content="Update 6" />
                    <Button Classes="ghost" Content="Clear" />
                    <Button Classes="danger" Content="Remove" />
                    <Button Classes="accentOutline" Content="Add mods" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary small" Content="Log" />
                    <Button Classes="secondary large" Content="Manage mods" />
                    <controls:LaunchButton MinWidth="191" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <controls:StatusLabel Kind="Fits" Text="Fits" />
                    <controls:StatusLabel Kind="Installed" Text="Installed" />
                    <controls:StatusLabel Kind="Update" Text="Update" />
                    <controls:StatusLabel Kind="Warning" Text="Not 1.12.5" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="chip">
                        <TextBlock Text="tag: config" />
                    </Border>
                    <Border Classes="chip plain">
                        <TextBlock Text="LGPL-3.0" />
                    </Border>
                    <Border Classes="chip plain">
                        <TextBlock Classes="mono" Text="KSP 1.12.5" />
                    </Border>
                    <Border Classes="chip accent">
                        <TextBlock Text="Primary" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="action new">
                        <TextBlock Text="New" />
                    </Border>
                    <Border Classes="action update">
                        <TextBlock Text="Update" />
                    </Border>
                    <Border Classes="badge fits">
                        <TextBlock Text="newest fit" />
                    </Border>
                    <Border Classes="badge neutral">
                        <TextBlock Text="installed" />
                    </Border>
                    <Border Classes="badge warning">
                        <TextBlock Text="Not listed for 1.12.5" />
                    </Border>
                </StackPanel>
                <Border Classes="segmented" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton Classes="segment" GroupName="p" Content="All" IsChecked="True" />
                        <RadioButton Classes="segment" GroupName="p" Content="Picked" />
                        <RadioButton Classes="segment" GroupName="p" Content="Dependencies" />
                    </StackPanel>
                </Border>
                <ToggleButton Classes="switch" Content="Only compatible" Width="200" HorizontalAlignment="Left" />
                <ToggleButton Classes="switch" Content="Back up saves first" IsChecked="True" Width="200"
                              HorizontalAlignment="Left" />
                <TextBox Classes="search" PlaceholderText="Search" />
                <Border Classes="placeholder">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="NOT BUILT YET · PHASE 6" />
                        <TextBlock Text="Placeholder text" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Text -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontFamily" Value="{DynamicResource SpaceGrotesk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontFamily" Value="{DynamicResource SpaceGrotesk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="20.8" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- Small uppercase section labels (11 px, 600, letter-spacing .08em); write the text in capitals -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.88" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Buttons: accent / secondary / ghost / danger / accentOutline; sizes: default (36), .small (30), .large (44);
         .icon makes it square. Put the icon and text in a StackPanel with Spacing 8 (6 small, 10 large). -->
    <Style Selector="Button.accent, Button.secondary, Button.ghost, Button.danger, Button.accentOutline">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="14 0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.small">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10 0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.large">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="22 0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.icon.small">
        <Setter Property="Width" Value="30" />
    </Style>
    <Style Selector="Button.icon.large">
        <Setter Property="Width" Value="44" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Accent: no hover change in the mockups -->
    <Style
        Selector="Button.accent /template/ ContentPresenter, Button.accent:pointerover /template/ ContentPresenter, Button.accent:pressed /template/ ContentPresenter, Button.accent:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
        Selector="Button.accent:pointerover /template/ ContentPresenter, Button.accent:pressed /template/ ContentPresenter, Button.accent:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>

    <!-- A disabled accent button (e.g. Next while there are problems) is dimmed, so it doesn't look clickable -->
    <Style Selector="Button.accent:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Secondary and ghost: hover = #232327 background and light text (the mockups' .hv) -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style
        Selector="Button.secondary:pointerover /template/ ContentPresenter, Button.secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style
        Selector="Button.ghost:pointerover /template/ ContentPresenter, Button.ghost:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Danger ("Remove") and accent outline ("Add mods", "Update all") -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorLine}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accentOutline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
        Selector="Button.danger:pointerover /template/ ContentPresenter, Button.danger:pressed /template/ ContentPresenter, Button.danger:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorLine}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
    </Style>
    <Style
        Selector="Button.accentOutline:pointerover /template/ ContentPresenter, Button.accentOutline:pressed /template/ ContentPresenter, Button.accentOutline:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>

    <!-- Sidebar navigation item: 40 px, radius 8, 14 px / 500, icon 18 with a 12 px gap -->
    <Style Selector="Button.nav">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style
        Selector="Button.nav:pointerover /template/ ContentPresenter, Button.nav:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Background" Value="{DynamicResource NavActive}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style
        Selector="Button.nav.active:pointerover /template/ ContentPresenter, Button.nav.active:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavActive}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.nav.active controls|StrokeIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
</Styles>

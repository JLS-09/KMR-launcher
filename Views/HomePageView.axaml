<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels"
             xmlns:controls="using:KMRLauncherMvvm.Controls"
             xmlns:home="using:KMRLauncherMvvm.ViewModels.Home"
             xmlns:views="using:KMRLauncherMvvm.Views"
             x:DataType="vm:HomePageViewModel"
             x:Class="KMRLauncherMvvm.Views.HomePageView">

    <UserControl.Styles>
        <Style Selector="StackPanel.continueActions">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector=":is(UserControl).stacked StackPanel.continueActions">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Margin" Value="0 20 0 0" />
        </Style>
        <Style Selector="Border.homeStat">
            <Setter Property="Padding" Value="28 14" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1 0 0 0" />
        </Style>
        <Style Selector="TextBlock.homeStatValue">
            <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="29" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.homeStatDetail">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="StackPanel.preflightItem">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="StackPanel.preflightItem > TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="StackPanel.preflightItem > controls|StrokeIcon">
            <Setter Property="Size" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.instanceCard">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14 14 14 12" />
        </Style>
        <Style Selector="Border.attentionCard">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="StackPanel.instancesSection">
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector="Border.popularCard">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Border.feedCard">
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector=":is(UserControl).narrowRow Border.popularCard">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0 16 0 0" />
        </Style>
        <Style Selector=":is(UserControl).narrowRow Border.feedCard">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector=":is(UserControl).narrowRow Border.attentionCard">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0 16 0 0" />
        </Style>
        <Style Selector=":is(UserControl).narrowRow StackPanel.instancesSection">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="Border.attentionRow">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="Padding" Value="0 12" />
        </Style>
        <Style Selector="Border.attentionIcon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.attentionIcon controls|StrokeIcon">
            <Setter Property="Size" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.feedRow">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8 9" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.feedRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHover}" />
        </Style>
        <Style Selector="Border.instanceTag">
            <Setter Property="Padding" Value="6 2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer IsVisible="{Binding HasContinue}">
            <StackPanel>
                <!-- Continue where you left off -->
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 0 0 1" Padding="28 24">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="32">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="10">
                            <TextBlock Classes="label" Text="CONTINUE WHERE YOU LEFT OFF" />
                            <TextBlock Classes="semibold" FontFamily="{DynamicResource SpaceGrotesk}" FontSize="32"
                                       LineHeight="35.2" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Continue.Name, FallbackValue=''}" />
                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                <Border Classes="chip plain">
                                    <TextBlock Classes="mono" Text="{Binding Continue.KspText, FallbackValue=''}" />
                                </Border>
                                <!-- Wine is the only runner until the Proton work (Phase 8) -->
                                <Border Classes="chip plain">
                                    <TextBlock Text="Wine" />
                                </Border>
                                <Border Classes="chip accent" IsVisible="{Binding Continue.IsPrimary, FallbackValue=False}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <controls:StrokeIcon Data="{StaticResource IconStar}" Size="13" IsFilled="True"
                                                             VerticalAlignment="Center" />
                                        <TextBlock Text="Primary" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <TextBlock Classes="size12 errorText" Text="{Binding ActionError}" TextWrapping="Wrap"
                                       IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <StackPanel Classes="continueActions" Orientation="Horizontal" Spacing="10">
                            <Button Classes="ghost large" Command="{Binding OpenFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <controls:StrokeIcon Data="{StaticResource IconFolder}" Size="18"
                                                         VerticalAlignment="Center" />
                                    <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="secondary large" Command="{Binding ManageModsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <controls:StrokeIcon Data="{StaticResource IconPackage}" Size="18"
                                                         VerticalAlignment="Center" />
                                    <TextBlock Text="Manage mods" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <controls:LaunchButton MinWidth="191" Command="{Binding LaunchCommand}">
                                <controls:LaunchButton.Menu>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Launch arguments…" Command="{Binding LaunchArgumentsCommand}" />
                                    </MenuFlyout>
                                </controls:LaunchButton.Menu>
                            </controls:LaunchButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stats strip -->
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 0 0 1" ClipToBounds="True">
                    <UniformGrid Rows="1">
                        <Border Classes="homeStat" Margin="-1 0 0 0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="LAST PLAYED" />
                                <TextBlock Classes="homeStatValue" Text="{Binding Continue.LastPlayed, FallbackValue=''}" />
                                <TextBlock Classes="homeStatDetail"
                                           Text="{Binding Continue.LastPlayedDetail, FallbackValue=''}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="homeStat">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="PLAYTIME" />
                                <TextBlock Classes="homeStatValue" Text="{Binding Continue.PlayTime, FallbackValue=''}" />
                                <TextBlock Classes="homeStatDetail" Text="in total" />
                            </StackPanel>
                        </Border>
                        <Border Classes="homeStat">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="MODS" />
                                <TextBlock Classes="homeStatValue" Text="{Binding Continue.ModsCount, FallbackValue=''}" />
                                <TextBlock Classes="homeStatDetail" Text="{Binding Continue.ModsDetail, FallbackValue=''}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="homeStat">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="INSTALL SIZE" />
                                <TextBlock Classes="homeStatValue" Text="{Binding InstallSize}" />
                                <TextBlock Classes="homeStatDetail" Text="{Binding GameDataSize}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>

                <!-- Pre-flight -->
                <Border Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0 0 0 1" Padding="28 12">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="20">
                        <WrapPanel ItemSpacing="20" LineSpacing="8">
                            <TextBlock Classes="label" Text="PRE-FLIGHT" VerticalAlignment="Center" />
                            <StackPanel Classes="preflightItem">
                                <controls:StrokeIcon Data="{StaticResource IconCheck}"
                                                     Foreground="{DynamicResource StatusFits}" />
                                <TextBlock Text="{Binding Continue.ReadyText, FallbackValue=''}" />
                            </StackPanel>
                            <StackPanel Classes="preflightItem"
                                        IsVisible="{Binding Continue.HasUpdates, FallbackValue=False}">
                                <controls:StrokeIcon Data="{StaticResource IconArrowUp}"
                                                     Foreground="{DynamicResource StatusUpdate}" />
                                <TextBlock Text="{Binding Continue.UpdatesText, FallbackValue=''}" />
                            </StackPanel>
                            <StackPanel Classes="preflightItem"
                                        IsVisible="{Binding Continue.HasNotListed, FallbackValue=False}">
                                <controls:StrokeIcon Data="{StaticResource IconWarning}"
                                                     Foreground="{DynamicResource StatusWarning}" />
                                <TextBlock Text="{Binding Continue.NotListedText, FallbackValue=''}" />
                            </StackPanel>
                        </WrapPanel>
                        <Button Grid.Column="1" Classes="link" FontWeight="Medium" VerticalAlignment="Center"
                                Content="Review" Command="{Binding ReviewCommand}" />
                    </Grid>
                </Border>

                <Grid Margin="28 24 28 32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="24">
                        <Grid ColumnDefinitions="3*, 16, 2*" RowDefinitions="Auto, Auto">
                            <!-- Instances -->
                            <StackPanel Classes="instancesSection" Grid.Row="0" Grid.Column="0" Spacing="12"
                                        VerticalAlignment="Top">
                                <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" Classes="h2" Text="Instances" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="mono muted size12" Text="{Binding InstanceCount}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Classes="link" FontWeight="Medium" VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}" Content="Manage"
                                            Command="{Binding ManageInstancesCommand}" />
                                    <Button Grid.Column="4" Classes="secondary small" Command="{Binding NewInstanceCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:StrokeIcon Data="{StaticResource IconPlus}" Size="14"
                                                                 VerticalAlignment="Center" />
                                            <TextBlock Text="New instance" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="InstanceCards" ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding $parent[views:HomePageView].CardColumns}"
                                                         ColumnSpacing="12" RowSpacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="home:HomeInstanceCard">
                                            <Border Classes="instanceCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Classes="size14 semibold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name}" />
                                                        <InlineUIContainer BaselineAlignment="Center">
                                                            <controls:StrokeIcon Data="{StaticResource IconStar}" Size="13"
                                                                                 IsFilled="True" Margin="8 0 0 0"
                                                                                 Foreground="{DynamicResource AccentText}"
                                                                                 IsVisible="{Binding IsPrimary}" />
                                                        </InlineUIContainer>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Classes="mono muted size12" Text="{Binding Version}" />
                                                        <TextBlock Classes="muted size12" Text="{Binding ModsText}" />
                                                        <TextBlock Classes="muted size12" Text="{Binding SizeText}" />
                                                    </StackPanel>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 1 0 0"
                                                            Padding="0 8 0 0">
                                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                                            <controls:StrokeIcon Grid.Column="0" Data="{StaticResource IconClock}"
                                                                                 Size="13" VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource TextMuted}" />
                                                            <TextBlock Grid.Column="1" Classes="secondary size12"
                                                                       VerticalAlignment="Center" Text="{Binding LastPlayedText}" />
                                                            <Button Grid.Column="2" Classes="secondary icon small" Width="32"
                                                                    Height="32" CornerRadius="7" ToolTip.Tip="{Binding LaunchTip}"
                                                                    Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).LaunchInstanceCommand}"
                                                                    CommandParameter="{Binding Instance}">
                                                                <controls:StrokeIcon Data="{StaticResource IconPlay}" Size="14"
                                                                                     IsFilled="True" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Needs attention -->
                            <Border Classes="attentionCard" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"
                                    Padding="20 20 20 8">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0 0 0 12">
                                        <TextBlock Classes="h2" Text="Needs attention" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="mono muted size12"
                                                   Text="{Binding AttentionCount}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Attention}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="home:AttentionRow">
                                                <Border Classes="attentionRow">
                                                    <Grid ColumnDefinitions="34, *, Auto" ColumnSpacing="12">
                                                        <Border Classes="attentionIcon">
                                                            <Panel>
                                                                <controls:StrokeIcon Data="{StaticResource IconArrowUp}"
                                                                                     Foreground="{DynamicResource StatusUpdate}"
                                                                                     IsVisible="{Binding IsUpdates}" />
                                                                <controls:StrokeIcon Data="{StaticResource IconWarning}"
                                                                                     Foreground="{DynamicResource StatusWarning}"
                                                                                     IsVisible="{Binding IsNotListed}" />
                                                                <controls:StrokeIcon Data="{StaticResource IconPackage}"
                                                                                     Foreground="{DynamicResource TextSecondary}"
                                                                                     IsVisible="{Binding IsReplacements}" />
                                                                <controls:StrokeIcon Data="{StaticResource IconDrive}"
                                                                                     Foreground="{DynamicResource TextSecondary}"
                                                                                     IsVisible="{Binding IsUnusedDownloads}" />
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Classes="size14 medium" Text="{Binding Title}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Classes="muted size12" Text="{Binding Detail}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="secondary small"
                                                                VerticalAlignment="Center" Content="{Binding ButtonText}"
                                                                Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).AttentionActionCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Nothing to show (not in the mockups) -->
                                    <Border Classes="attentionRow" IsVisible="{Binding HasNoAttention}">
                                        <Grid ColumnDefinitions="34, *" ColumnSpacing="12">
                                            <Border Classes="attentionIcon">
                                                <controls:StrokeIcon Data="{StaticResource IconCheck}"
                                                                     Foreground="{DynamicResource StatusFits}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="size14 medium" Text="Nothing needs attention" />
                                                <TextBlock Classes="muted size12" TextWrapping="Wrap"
                                                           Text="No updates, issues or unused downloads" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Classes="size12 errorText" Margin="0 0 0 12" TextWrapping="Wrap"
                                               Text="{Binding AttentionError}"
                                               IsVisible="{Binding AttentionError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="3*, 16, 2*" RowDefinitions="Auto, Auto">
                            <!-- New on CKAN since your last sync -->
                            <Border Classes="feedCard" Grid.Row="0" Grid.Column="0" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"
                                    Padding="20" VerticalAlignment="Top">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                            <TextBlock Classes="h2" Text="New on CKAN since your last sync" />
                                            <TextBlock Classes="muted size12" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Feed.HasChanges}">
                                                <Run FontFamily="{DynamicResource Mono}" Text="{Binding Feed.CommitsText}" /><Run Text="{Binding Feed.TimesText}" />
                                            </TextBlock>
                                            <!-- Nothing compared yet (not in the mockups) -->
                                            <TextBlock Classes="muted size12" TextWrapping="Wrap"
                                                       IsVisible="{Binding !Feed.HasChanges}"
                                                       Text="New versions show up here after the next fetch that brings changes." />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="segmented raised" VerticalAlignment="Bottom"
                                                IsVisible="{Binding Feed.HasChanges}">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <RadioButton Classes="segment" GroupName="feedTab"
                                                             IsChecked="{Binding FeedTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static home:FeedTab.YourMods}}"
                                                             Command="{Binding SelectFeedTabCommand}"
                                                             CommandParameter="{x:Static home:FeedTab.YourMods}">
                                                    <TextBlock>
                                                        <Run Text="Your mods " /><Run FontFamily="{DynamicResource Mono}" Foreground="{DynamicResource TextSecondary}"
                                                             Text="{Binding Feed.YourMods.Count}" />
                                                    </TextBlock>
                                                </RadioButton>
                                                <RadioButton Classes="segment" GroupName="feedTab"
                                                             IsChecked="{Binding FeedTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static home:FeedTab.AllUpdates}}"
                                                             Command="{Binding SelectFeedTabCommand}"
                                                             CommandParameter="{x:Static home:FeedTab.AllUpdates}">
                                                    <TextBlock>
                                                        <Run Text="All updates " /><Run FontFamily="{DynamicResource Mono}" Foreground="{DynamicResource TextSecondary}"
                                                             Text="{Binding Feed.AllUpdates.Count}" />
                                                    </TextBlock>
                                                </RadioButton>
                                                <RadioButton Classes="segment" GroupName="feedTab"
                                                             IsChecked="{Binding FeedTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static home:FeedTab.NewMods}}"
                                                             Command="{Binding SelectFeedTabCommand}"
                                                             CommandParameter="{x:Static home:FeedTab.NewMods}">
                                                    <TextBlock>
                                                        <Run Text="New mods " /><Run FontFamily="{DynamicResource Mono}" Foreground="{DynamicResource TextSecondary}"
                                                             Text="{Binding Feed.NewMods.Count}" />
                                                    </TextBlock>
                                                </RadioButton>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <StackPanel IsVisible="{Binding Feed.HasChanges}">
                                        <ItemsControl ItemsSource="{Binding FeedRows}" Grid.IsSharedSizeScope="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="home:FeedRow">
                                                    <Border Classes="feedRow">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.3*" />
                                                                <ColumnDefinition Width="1.5*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="feedButton" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Classes="size14 medium" Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="muted size12" Text="{Binding When}" />
                                                            </StackPanel>
                                                            <Grid Grid.Column="1" ColumnDefinitions="Auto, Auto, *" ColumnSpacing="6"
                                                                  VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Classes="mono muted size12"
                                                                           Text="{Binding From}" MaxWidth="140"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding HasFrom}" />
                                                                <controls:StrokeIcon Grid.Column="1" Data="{StaticResource IconArrowRight}"
                                                                                     Size="12" VerticalAlignment="Center"
                                                                                     Foreground="{DynamicResource TextMuted}"
                                                                                     IsVisible="{Binding HasFrom}" />
                                                                <TextBlock Grid.Column="2" Classes="mono size12" Text="{Binding To}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Instances}"
                                                                          VerticalAlignment="Center" IsVisible="{Binding !IsNewMod}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Border Classes="instanceTag">
                                                                            <TextBlock Classes="secondary size11" Text="{Binding}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Classes="muted size12"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding Abstract}" IsVisible="{Binding IsNewMod}" />
                                                            <Button Grid.Column="3" Classes="secondary small" Content="Update"
                                                                    VerticalAlignment="Center" IsVisible="{Binding CanUpdate}"
                                                                    Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).UpdateFeedRowCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Empty tab (not in the mockups) -->
                                        <Border Classes="feedRow" IsVisible="{Binding !FeedRows.Count}">
                                            <TextBlock Classes="muted size13" Text="{Binding FeedEmptyText}" />
                                        </Border>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding Feed.HasChanges}">
                                        <Button Grid.Column="0" Classes="link" FontWeight="Medium" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" Content="{Binding ShowAllFeedText}"
                                                Command="{Binding ShowAllFeedCommand}"
                                                IsVisible="{Binding CanShowAllFeedRows}" />
                                        <Button Grid.Column="1" Classes="accentOutline" Command="{Binding UpdateAllFeedCommand}"
                                                IsVisible="{Binding CanUpdateAll}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:StrokeIcon Data="{StaticResource IconArrowUp}" Size="16"
                                                                     Foreground="{DynamicResource AccentText}"
                                                                     VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UpdateAllText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Popular for KSP x.y.z -->
                            <Border Classes="popularCard" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"
                                    Padding="20" VerticalAlignment="Top">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="h2" Text="{Binding PopularTitle}" />
                                        <TextBlock Classes="muted size12" Text="{Binding PopularSubtitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Popular}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="home:PopularRow">
                                                    <Border Classes="feedRow">
                                                        <Grid ColumnDefinitions="18, *, Auto, Auto" ColumnSpacing="12">
                                                            <TextBlock Grid.Column="0" Classes="mono muted size12"
                                                                       VerticalAlignment="Center" Text="{Binding Rank}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Classes="size14 medium" Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="muted size12" Text="{Binding Abstract}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                                        VerticalAlignment="Center">
                                                                <controls:StrokeIcon Data="{StaticResource IconDownload}" Size="12"
                                                                                     VerticalAlignment="Center"
                                                                                     Foreground="{DynamicResource TextMuted}" />
                                                                <TextBlock Classes="mono secondary size12"
                                                                           VerticalAlignment="Center" Text="{Binding Downloads}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Classes="secondary icon small"
                                                                    VerticalAlignment="Center" ToolTip.Tip="{Binding AddTip}"
                                                                    Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).AddPopularCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <controls:StrokeIcon Data="{StaticResource IconPlus}" Size="14" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Nothing to suggest (not in the mockups) -->
                                        <Border Classes="feedRow" IsVisible="{Binding HasNoPopular}">
                                            <TextBlock Classes="muted size13" TextWrapping="Wrap"
                                                       Text="Download counts come with the mod list; nothing to suggest yet." />
                                        </Border>
                                    </StackPanel>
                                    <Button Classes="link" FontWeight="Medium" HorizontalAlignment="Left"
                                            Command="{Binding BrowseModsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Browse all mods" VerticalAlignment="Center" />
                                            <controls:StrokeIcon Data="{StaticResource IconArrowRight}" Size="14"
                                                                 Foreground="{DynamicResource AccentText}"
                                                                 VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- No instances (not in the mockups) -->
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding !HasContinue}">
            <TextBlock Classes="h2" Text="No instances yet" HorizontalAlignment="Center" />
            <TextBlock Classes="muted size13" HorizontalAlignment="Center"
                       Text="Create one from a KSP zip or an existing KSP folder to start installing mods." />
            <Button Classes="accent" HorizontalAlignment="Center" Content="New instance"
                    Command="{Binding NewInstanceCommand}" />
        </StackPanel>
    </Panel>
</UserControl>

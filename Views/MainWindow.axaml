<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KMRLauncherMvvm.ViewModels"
        xmlns:controls="using:KMRLauncherMvvm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        Width="1400" Height="800" MinWidth="1000" MinHeight="600"
        x:Class="KMRLauncherMvvm.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Images/logoSmall.png"
        Title="KMR Launcher"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource Inter}"
        FontSize="14">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="StackPanel.status > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.status > TextBlock.sep">
            <Setter Property="Foreground" Value="{DynamicResource LineStrong}" />
        </Style>
        <Style Selector="StackPanel.status > controls|StrokeIcon">
            <Setter Property="Size" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="216, *">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0 0 1 0" Padding="12 16">
                <DockPanel>
                    <!-- Logo lockup: rocket (flame follows the accent) + KMR / LAUNCHER -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="10 6 10 22">
                        <Viewbox Width="30" Height="56" Stretch="Uniform">
                            <Canvas Width="44" Height="89">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="-28" Y="-8" />
                                </Canvas.RenderTransform>
                                <Path Fill="{DynamicResource TextPrimary}" Data="{StaticResource LogoRocketBody}" />
                                <Path Fill="{DynamicResource TextPrimary}" Data="{StaticResource LogoRocketWindow}" />
                                <Path Fill="{DynamicResource Accent}" Data="{StaticResource LogoFlame}" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center" Spacing="-4">
                            <TextBlock Text="KMR" FontFamily="{DynamicResource SpaceGrotesk}" FontWeight="Bold"
                                       FontSize="40" LetterSpacing="4" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="LAUNCHER" FontFamily="{DynamicResource SpaceGrotesk}" FontWeight="Medium"
                                       FontSize="11" LetterSpacing="4.5" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom: the primary instance, or the game that is running -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0 1 0 0"
                            Padding="4 14 4 2">
                        <Panel>
                            <!-- Running (started from here). Log and Stop come with Phase 5 task 5. -->
                            <StackPanel Spacing="8" IsVisible="{Binding IsRunning}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource StatusFits}"
                                             VerticalAlignment="Center" Margin="0 0 8 0" />
                                    <TextBlock Grid.Column="1" Classes="label" Text="RUNNING"
                                               Foreground="{DynamicResource StatusFits}" />
                                    <TextBlock Grid.Column="2" Classes="mono secondary" FontSize="12"
                                               Text="{Binding RunningTime}" />
                                </Grid>
                                <TextBlock Text="{Binding RunningInstanceName}" FontSize="13" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid ColumnDefinitions="*, 6, *">
                                    <Button Grid.Column="0" Classes="secondary small" HorizontalAlignment="Stretch"
                                            IsEnabled="False" ToolTip.ShowOnDisabled="True"
                                            ToolTip.Tip="Not built yet (Phase 5 task 5). Wine's output still goes to the console.">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:StrokeIcon Data="{StaticResource IconTerminal}" Size="14" />
                                            <TextBlock Text="Log" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="secondary small" HorizontalAlignment="Stretch"
                                            IsEnabled="False" ToolTip.ShowOnDisabled="True"
                                            ToolTip.Tip="Not built yet (Phase 5 task 5)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:StrokeIcon Data="{StaticResource IconStop}" Size="14" />
                                            <TextBlock Text="Stop" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Idle: primary instance with Launch -->
                            <StackPanel Spacing="8" IsVisible="{Binding !IsRunning}">
                                <StackPanel Spacing="8" IsVisible="{Binding HasPrimaryInstance}">
                                    <TextBlock Classes="label" Text="PRIMARY INSTANCE" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding PrimaryInstance.Name, FallbackValue=''}" FontSize="13"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="mono muted" FontSize="11"
                                                   Text="{Binding PrimaryInstance.Version, StringFormat='KSP {0}', FallbackValue=''}" />
                                    </StackPanel>
                                    <controls:LaunchButton Command="{Binding LaunchPrimaryCommand}">
                                        <controls:LaunchButton.Menu>
                                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                                <MenuItem Header="Instance settings…"
                                                          Command="{Binding OpenPrimaryInstanceSettingsCommand}" />
                                                <MenuItem Header="Open folder"
                                                          Command="{Binding OpenPrimaryInstanceFolderCommand}" />
                                                <Separator />
                                                <MenuItem Header="Launch with Proton" IsEnabled="False"
                                                          ToolTip.ShowOnDisabled="True"
                                                          ToolTip.Tip="Not built yet (Phase 8, Proton)" />
                                            </MenuFlyout>
                                        </controls:LaunchButton.Menu>
                                    </controls:LaunchButton>
                                </StackPanel>
                                <StackPanel Spacing="8" IsVisible="{Binding !HasPrimaryInstance}">
                                    <TextBlock Classes="muted" FontSize="13" Text="No instances yet" />
                                    <Button Classes="secondary small" HorizontalAlignment="Stretch"
                                            Command="{Binding GoToInstancesCommand}" Content="Go to Instances" />
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding LaunchError}" IsVisible="{Binding LaunchError, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{DynamicResource StatusError}" FontSize="12" TextWrapping="Wrap"
                               Margin="4 0 4 10" />

                    <Button DockPanel.Dock="Bottom" Classes="nav" Classes.active="{Binding SettingsPageIsActive}"
                            Command="{Binding GoToSettingsCommand}" Margin="0 0 0 12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:StrokeIcon Data="{StaticResource IconSettings}" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="4">
                        <Button Classes="nav" Classes.active="{Binding HomePageIsActive}"
                                Command="{Binding GoToHomeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:StrokeIcon Data="{StaticResource IconHome}" VerticalAlignment="Center" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding DiscoverPageIsActive}"
                                Command="{Binding GoToDiscoverCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:StrokeIcon Data="{StaticResource IconDiscover}" VerticalAlignment="Center" />
                                <TextBlock Text="Discover" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding InstancesPageIsActive}"
                                Command="{Binding GoToInstancesCommand}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <controls:StrokeIcon Grid.Column="0" Data="{StaticResource IconInstances}"
                                                     VerticalAlignment="Center" Margin="0 0 12 0" />
                                <TextBlock Grid.Column="1" Text="Instances" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="mono muted" FontSize="11"
                                           Text="{Binding InstanceCount}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Top bar + page -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0 0 0 1" Padding="28 16">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Classes="h1" Text="{Binding PageTitle}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" Width="400"
                                 Text="{Binding SearchText}" PlaceholderText="{Binding SearchPlaceholder}"
                                 IsEnabled="{Binding CanSearch}">
                            <TextBox.InnerLeftContent>
                                <controls:StrokeIcon Data="{StaticResource IconSearch}" Size="16" Margin="2 0 0 0"
                                                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <Border Classes="kbd" Margin="0 0 2 0">
                                    <TextBlock Text="Ctrl K" />
                                </Border>
                            </TextBox.InnerRightContent>
                        </TextBox>
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0 1 0 0" MinHeight="30" Padding="16 4">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Classes="status" Orientation="Horizontal" Spacing="8">
                    <controls:StrokeIcon Data="{StaticResource IconBranch}" />
                    <TextBlock Text="CKAN-meta" />
                    <TextBlock Classes="mono" Text="{Binding StatusBar.RepoText}" />
                    <TextBlock Classes="sep" Text="|" />
                    <TextBlock Text="{Binding StatusBar.VersionsText}" />
                    <TextBlock Classes="sep" Text="|" />
                    <!-- Placeholder: the time of the last sync is saved by the startup work (Phase 6 task 1) -->
                    <TextBlock Text="last sync –" ToolTip.Tip="Not built yet: the sync time is saved from Phase 6 (startup window) on" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="status" Orientation="Horizontal" Spacing="8">
                    <controls:StrokeIcon Data="{StaticResource IconDownload}" />
                    <!-- Installs are modal for now, so nothing downloads while this is visible -->
                    <TextBlock Text="Downloads idle" />
                    <TextBlock Classes="sep" Text="|" />
                    <controls:StrokeIcon Data="{StaticResource IconDrive}" />
                    <TextBlock Text="{Binding StatusBar.CacheText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1184" d:DesignHeight="760"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels"
             xmlns:discover="clr-namespace:KMRLauncherMvvm.ViewModels.Discover"
             xmlns:controls="using:KMRLauncherMvvm.Controls"
             x:DataType="vm:DiscoverPageViewModel"
             x:Class="KMRLauncherMvvm.Views.DiscoverPageView"
             Foreground="{DynamicResource TextPrimary}">

    <UserControl.Styles>
        <!-- A block in the filters column or the details panel -->
        <Style Selector="Border.block">
            <Setter Property="Padding" Value="20 18" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>
        <Style Selector="Border.block.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- List header -->
        <Style Selector="TextBlock.columnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.66" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Mod rows: the row shown in the details panel gets an accent outline -->
        <Style Selector="ListBox.mods ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.mods ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHover}" />
        </Style>
        <Style Selector="ListBox.mods ListBoxItem:selected /template/ ContentPresenter, ListBox.mods ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedRow}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Version rows in the details panel -->
        <Style Selector="ListBox.versions ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.versions ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHover}" />
        </Style>
        <Style Selector="Border.versionRow.fits">
            <Setter Property="Background" Value="{DynamicResource FitsRow}" />
        </Style>
        <Style Selector="Border.versionRow.checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <Style Selector="TextBlock.version">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.version.fits">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.ksp.fits">
            <Setter Property="Foreground" Value="{DynamicResource StatusFits}" />
        </Style>

        <!-- Narrow page (below 1070 px = filters 210 + list 520 + details 340): the details panel lies over
             the right side of the list instead of taking a column of its own (set in the code-behind) -->
        <!-- Set in styles, not on the element: a value set on the element would win over the narrow style -->
        <Style Selector="Border#DetailsPanel">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector=":is(UserControl).narrow Border#DetailsPanel">
            <!-- Only column 1 (the list): spanning the Auto column too would make the Grid widen that column -->
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="BoxShadow" Value="-16 0 32 0 #99000000" />
        </Style>

        <!-- Selected-mod chips in the tray -->
        <Style Selector="Border.selectionChip">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10 0 4 0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.chipRemove">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chipRemove:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="210, *, Auto">

        <!-- Filters -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0 0 1 0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Classes="block">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="label" Text="CHECK AGAINST" />
                            <controls:InstancePicker Instances="{Binding Instances}"
                                                     SelectedInstance="{Binding CheckAgainst}" />
                            <ToggleButton Classes="switch" Content="Only compatible" IsChecked="{Binding OnlyCompatible}" />
                            <ToggleButton Classes="switch" Content="Hide installed" IsChecked="{Binding HideInstalled}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="block">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="TAGS" Margin="0 0 0 6" />
                            <ItemsControl ItemsSource="{Binding VisibleTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="discover:FilterOptionViewModel">
                                        <CheckBox Classes="box filterRow" IsChecked="{Binding IsChecked}">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="mono muted size11"
                                                           Text="{Binding CountText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="ghost small" Height="30" Padding="8 0" FontSize="12"
                                    HorizontalAlignment="Left" CornerRadius="6"
                                    IsVisible="{Binding HasMoreTags}" Content="{Binding MoreTagsText}"
                                    Command="{Binding ToggleMoreTagsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="block last">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="KIND" Margin="0 0 0 6" />
                            <ItemsControl ItemsSource="{Binding Kinds}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="discover:FilterOptionViewModel">
                                        <CheckBox Classes="box filterRow" IsChecked="{Binding IsChecked}">
                                            <TextBlock Text="{Binding Name}" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Mod list -->
        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *, Auto">
            <!-- Toolbar: active filters, count, sort -->
            <Border Grid.Row="0" MinHeight="52" Padding="20 8" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0 0 0 1">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center" ItemSpacing="8" LineSpacing="8">
                        <ItemsControl ItemsSource="{Binding ActiveFilters}" IsVisible="{Binding HasActiveFilters}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="ghost small" Height="24" Padding="8 0" CornerRadius="6" FontSize="12"
                                IsVisible="{Binding HasActiveFilters}" Content="Clear filters"
                                Command="{Binding ClearFiltersCommand}" VerticalAlignment="Center" />
                        <TextBlock Classes="size13 muted" VerticalAlignment="Center"
                                   Margin="4 0 0 0">
                            <Run FontFamily="{DynamicResource Mono}" Foreground="{DynamicResource TextSecondary}"
                                 Text="{Binding ShownCount}" />
                            <Run Text=" mods" />
                        </TextBlock>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="size12 muted" Text="Sort"
                                   VerticalAlignment="Center" />
                        <!-- Placeholder: sorting is a Phase 8 feature; the list is sorted by name for now -->
                        <Button Classes="secondary small" ToolTip.Tip="Not built yet: sorting comes in Phase 8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Name" VerticalAlignment="Center" />
                                <controls:StrokeIcon Data="{StaticResource IconChevronDown}" Size="14"
                                                     VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column header -->
            <Border Grid.Row="1" Height="38" Padding="20 0" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0 0 0 1">
                <Grid ColumnDefinitions="28, *, 104, 76, 100" ColumnSpacing="12">
                    <TextBlock Grid.Column="1" Classes="columnHeader" Text="MOD" />
                    <TextBlock Grid.Column="2" Classes="columnHeader" Text="KSP" />
                    <TextBlock Grid.Column="3" Classes="columnHeader" Text="DOWNLOADS" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Classes="columnHeader" Text="STATUS" />
                </Grid>
            </Border>

            <!-- Rows -->
            <Panel Grid.Row="2">
                <ListBox Classes="mods" Background="Transparent" ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding FocusedRow}" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="discover:ModListItemViewModel">
                            <Border MinHeight="52" Padding="20 6" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="0 0 0 1">
                                <Grid ColumnDefinitions="28, *, 104, 76, 100" ColumnSpacing="12">
                                    <CheckBox Grid.Column="0" Classes="box" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{Binding Mod.Name, StringFormat='Select {0}'}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="size14 medium" Text="{Binding Mod.Name}"
                                                   LineHeight="20.3" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="size12 muted" Text="{Binding Authors}" LineHeight="17.4"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <controls:KspStrip Grid.Column="2" Version="{Binding SelectedVersion}"
                                                       VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Classes="mono size12 secondary" Text="{Binding Downloads}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <controls:StatusLabel Grid.Column="4" Kind="{Binding StatusKind}"
                                                          Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Classes="size13 muted" Text="No mods match the filters"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding HasNoRows}" />

                <!-- While CKAN-meta is fetched and read (not in the mockups) -->
                <Border Background="{DynamicResource Background}" IsVisible="{Binding IsLoading}">
                    <StackPanel Width="360" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="LOADING THE MOD LIST" />
                        <ProgressBar Height="4" MinHeight="4" CornerRadius="2"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Off}"
                                     Value="{Binding LoadProgress.ModsReceived}"
                                     Maximum="{Binding LoadProgress.TotalMods}"
                                     IsIndeterminate="{Binding LoadProgress.IsCache}" />
                        <TextBlock Classes="mono muted size12" Text="{Binding LoadProgress.CurrentModName}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Selection tray -->
            <Border Grid.Row="3" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Accent}"
                    BorderThickness="0 2 0 0" Padding="20 14" IsVisible="{Binding HasSelectedMods}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" MinWidth="26" Height="26" Padding="6 0" CornerRadius="13"
                                Background="{DynamicResource Accent}">
                            <TextBlock Classes="mono size12 semibold"
                                       Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Text="{Binding SelectedMods.Count}" />
                        </Border>
                        <TextBlock Classes="size14 semibold" Grid.Column="1" Text="mods selected"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="ghost small" Content="Clear"
                                Command="{Binding ClearSelectionCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SelectedMods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="6" LineSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="discover:ModListItemViewModel">
                                <Border Classes="selectionChip">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="size13" Text="{Binding Mod.Name}" VerticalAlignment="Center" />
                                        <TextBlock Classes="mono muted size12" VerticalAlignment="Center"
                                                   Text="{Binding SelectedVersion.Version}" />
                                        <Button Classes="chipRemove"
                                                Command="{Binding $parent[ItemsControl].((vm:DiscoverPageViewModel)DataContext).DeselectCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Mod.Name, StringFormat='Remove {0} from selection'}">
                                            <controls:StrokeIcon Data="{StaticResource IconClose}" Size="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 1 0 0" Padding="0 12 0 0">
                        <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="10">
                            <TextBlock Classes="size13 secondary" Grid.Column="0" Text="Install to" VerticalAlignment="Center" />
                            <controls:InstancePicker Grid.Column="1" IsCompact="True"
                                                     Instances="{Binding Instances}"
                                                     SelectedInstance="{Binding InstallTarget}" />
                            <Button Grid.Column="3" Classes="accent" Command="{Binding ApplyChangesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Review changes" VerticalAlignment="Center" />
                                    <controls:StrokeIcon Data="{StaticResource IconArrowRight}" Size="16"
                                                         Foreground="{DynamicResource OnAccent}"
                                                         VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Details panel -->
        <Border x:Name="DetailsPanel" Width="340" BorderBrush="{DynamicResource Line}"
                BorderThickness="1 0 0 0" Background="{DynamicResource Background}"
                IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Details}">
                <StackPanel x:DataType="discover:ModDetailsViewModel">
                    <!-- Name, authors, identifier, license, tags -->
                    <Border Classes="block">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <TextBlock Classes="semibold" Grid.Column="0" Text="{Binding Mod.Name}"
                                           FontSize="22" LineHeight="26.4"
                                           FontFamily="{DynamicResource SpaceGrotesk}"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="1" Classes="ghost icon" Width="32" Height="32"
                                        VerticalAlignment="Top" ToolTip.Tip="Close details"
                                        Command="{Binding $parent[UserControl].((vm:DiscoverPageViewModel)DataContext).CloseDetailsCommand}">
                                    <controls:StrokeIcon Data="{StaticResource IconClose}" Size="16" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="size13 secondary" Text="{Binding Authors}" TextWrapping="Wrap" />
                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                <Border Classes="chip plain">
                                    <TextBlock Classes="mono" Text="{Binding Mod.Id}" />
                                </Border>
                                <Border Classes="chip plain" IsVisible="{Binding License, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding License}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="chip plain">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="block">
                        <TextBlock Classes="size13 secondary" Text="{Binding Description}" LineHeight="20.15"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Versions: every version, tick one to select the mod with it -->
                    <Border Classes="block">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="VERSIONS" VerticalAlignment="Bottom" />
                                <TextBlock Classes="size12 muted" Grid.Column="1">
                                    <Run FontFamily="{DynamicResource Mono}" Text="{Binding VersionCount}" />
                                    <Run Text=" · tick one to select" />
                                </TextBlock>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 1">
                                <ListBox Classes="versions" MaxHeight="300" Background="Transparent"
                                         ItemsSource="{Binding Versions}" SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="discover:VersionRowViewModel">
                                            <Border Classes="versionRow" Classes.fits="{Binding Fits}"
                                                    Classes.checked="{Binding IsChecked}" Padding="10 8"
                                                    BorderBrush="{DynamicResource Line}" BorderThickness="0 0 0 1">
                                                <Grid ColumnDefinitions="18, *, Auto" RowDefinitions="Auto, Auto"
                                                      ColumnSpacing="10" RowSpacing="4">
                                                    <CheckBox Grid.Row="0" Grid.Column="0" Classes="box"
                                                              IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono version"
                                                               Classes.fits="{Binding Fits}" FontSize="12"
                                                               Text="{Binding Version.Version}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                                Spacing="4">
                                                        <Border Classes="badge fits" IsVisible="{Binding IsNewestFit}">
                                                            <TextBlock Text="newest fit" />
                                                        </Border>
                                                        <Border Classes="badge neutral" IsVisible="{Binding IsInstalled}">
                                                            <TextBlock Text="installed" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Classes="mono version ksp" Classes.fits="{Binding Fits}"
                                                                   FontSize="12" Text="{Binding KspText}" />
                                                        <TextBlock Classes="mono muted size12"
                                                                   Text="{Binding DateText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <WrapPanel ItemSpacing="14" LineSpacing="6" IsVisible="{Binding HasInstance}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource StatusFits}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Classes="size12 muted"
                                               Text="{Binding FitsLegend}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ToggleOff}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Classes="size12 muted" Text="Doesn't fit" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- KSP compatibility of the version that would be installed -->
                    <Border Classes="block">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="label" Text="KSP COMPATIBILITY" VerticalAlignment="Center" />
                                <Border Classes="badge warning" IsVisible="{Binding IsStrict}" Height="20"
                                        Padding="8 0" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <controls:StrokeIcon Data="{StaticResource IconLock}" Size="13" />
                                        <TextBlock Text="strict" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <controls:KspDetailStrip Version="{Binding ShownVersion}"
                                                     InstanceVersion="{Binding InstanceVersion}"
                                                     OnBrush="{DynamicResource TextSecondary}"
                                                     OffBrush="{DynamicResource Off}"
                                                     FitsBrush="{DynamicResource StatusFits}"
                                                     LabelBrush="{DynamicResource TextMuted}"
                                                     FontFamily="{DynamicResource Mono}" />
                        </StackPanel>
                    </Border>

                    <!-- Depends, conflicts with the instance, reverse depends -->
                    <Border Classes="block" Classes.last="{Binding !HasLinks}">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="DEPENDS ON" Margin="0 0 0 4" />
                            <TextBlock Classes="size13 muted" Text="No dependencies"
                                       IsVisible="{Binding !HasDepends}" />
                            <ItemsControl ItemsSource="{Binding Depends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="discover:DependsRowViewModel">
                                        <Grid Height="30" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                            <controls:StrokeIcon Grid.Column="0" Data="{StaticResource IconCheck}"
                                                                 Size="14" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource StatusFits}"
                                                                 IsVisible="{Binding IsInstalled}" />
                                            <controls:StrokeIcon Grid.Column="0" Data="{StaticResource IconPlus}"
                                                                 Size="14" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TextMuted}"
                                                                 IsVisible="{Binding !IsInstalled}" />
                                            <TextBlock Grid.Column="1" Classes="mono size12" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Classes="size12 muted" Grid.Column="2" Text="{Binding StateText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0 8 0 0">
                                <TextBlock Classes="size12 muted" Text="{Binding ConflictsText}"
                                           IsVisible="{Binding !HasConflicts}" />
                                <TextBlock Classes="size12 warningText" Text="{Binding ConflictsText}"
                                           IsVisible="{Binding HasConflicts}" />
                                <TextBlock Classes="size12 muted">
                                    <Run Text="Needed by " />
                                    <Run FontFamily="{DynamicResource Mono}" Foreground="{DynamicResource TextSecondary}"
                                         Text="{Binding NeededBy}" />
                                    <Run Text=" mods" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Links -->
                    <Border Classes="block last" IsVisible="{Binding HasLinks}">
                        <ItemsControl ItemsSource="{Binding Links}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="discover:LinkViewModel">
                                    <Button Classes="secondary small" Command="{Binding OpenCommand}"
                                            ToolTip.Tip="{Binding Url}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:StrokeIcon Data="{StaticResource IconExternal}" Size="14"
                                                                 VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KMRLauncherMvvm.Controls">
    <!-- Segmented control: RadioButton.segment items in a StackPanel (Spacing 2) inside a Border.segmented.
         .raised = the variant on a card (Home's update feed) -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Border.segmented.raised">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    </Style>
    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="SegmentBorder" Height="28" Padding="10 0" CornerRadius="6" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#SegmentBorder">
        <Setter Property="Background" Value="{DynamicResource SegmentSelected}" />
    </Style>

    <!-- Switch: ToggleButton.switch, the label as Content (13 px, #A1A1AA) and a 38 x 22 switch on the right.
         Fluent's own switch control requires its knob parts in the template, so a plain ToggleButton is used. -->
    <!-- .big (Run with, Default runner): 30 px segments, padding 0 12, 13 px -->
    <Style Selector="RadioButton.segment.big">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="RadioButton.segment.big /template/ Border#SegmentBorder">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12 0" />
    </Style>
    <Style Selector="ToggleButton.switch">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Background="Transparent">
                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border Grid.Column="1" Name="Track" Width="38" Height="22" CornerRadius="11"
                            Background="{DynamicResource ToggleOff}">
                        <Border Name="Knob" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left"
                                Margin="2 0 0 0" Background="{DynamicResource TextPrimary}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Knob">
        <Setter Property="Margin" Value="18 0 0 0" />
    </Style>

    <!-- Checkbox: 16 px box (radius 4), accent fill with a check when ticked. Content (if any) 10 px to the right.
         .filterRow = a 30 px row in the filters column (15 px box, hover background, light text when ticked). -->
    <Style Selector="CheckBox.box">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="RowBorder" Background="Transparent" Padding="{TemplateBinding Padding}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{DynamicResource TextMuted}" Background="Transparent"
                                VerticalAlignment="Center">
                            <controls:StrokeIcon Name="Check" Data="{DynamicResource IconCheck}" Size="12"
                                                 StrokeThickness="3" Foreground="{DynamicResource OnAccent}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsVisible="False" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Name="PART_ContentPresenter" Margin="10 0 0 0"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.box:checked /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="CheckBox.box:checked /template/ controls|StrokeIcon#Check">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox.box.filterRow">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8 0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="CheckBox.box.filterRow /template/ Border#Box">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="CheckBox.box.filterRow:pointerover /template/ Border#RowBorder">
        <Setter Property="Background" Value="{DynamicResource RowHover}" />
    </Style>
    <Style Selector="CheckBox.box.filterRow:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
</Styles>

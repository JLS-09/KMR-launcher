<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
             xmlns:models="clr-namespace:KMRLauncherMvvm.Models"
             x:DataType="vm:InstallModsSummaryStepViewModel"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             Background="#1F1F20"
             Foreground="{DynamicResource PrimaryText}"
             x:Class="KMRLauncherMvvm.Views.InstallMods.InstallModsSummaryStepView">

    <UserControl.Styles>
        <!-- Read-only lists: hide the ListBox selection/hover look -->
        <Style Selector="ListBox.summary-list">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.summary-list > ListBoxItem">
            <Setter Property="Padding" Value="8 4" />
            <Setter Property="Margin" Value="0 0 0 4" />
            <Setter Property="Background" Value="{DynamicResource SideBarBackground}" />
        </Style>
        <Style Selector="ListBox.summary-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SideBarBackground}" />
        </Style>
        <Style Selector="ListBox.summary-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SideBarBackground}" />
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="FontFamily" Value="{DynamicResource SpaceMonoBold}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SummaryRow">
            <Grid ColumnDefinitions="* Auto Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Identifier}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryText}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" MinWidth="64"
                           TextAlignment="Right" Foreground="{DynamicResource SecondaryText}" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Margin="32 0 32 0" RowDefinitions="Auto Auto Auto * Auto Auto">
        <TextBlock Grid.Row="0" Margin="0 32 0 0" Text="{Binding TotalsText}" TextWrapping="Wrap" />

        <!-- Problems block Finish. Bounded height, so the ScrollViewer is fine. -->
        <Border Grid.Row="1" IsVisible="{Binding HasProblems}" Margin="0 16 0 0" Padding="12 8"
                Background="{DynamicResource SideBarBackground}"
                BorderBrush="{DynamicResource PrimaryRed}" BorderThickness="2 0 0 0">
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding InstallModsData.Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ResolutionProblem">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0 2"
                                       Foreground="{DynamicResource PrimaryRed}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Classes="header" Margin="0 24 0 8" Text="TO INSTALL" />
        <TextBlock Grid.Row="3" IsVisible="{Binding HasNothingToDo}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Nothing to do: every selected mod is already installed in this instance." />
        <ListBox Grid.Row="3" Classes="summary-list" ItemsSource="{Binding ToInstall}"
                 IsVisible="{Binding !HasNothingToDo}" />

        <TextBlock Grid.Row="4" Classes="header" Margin="0 16 0 8" Text="TO REMOVE"
                   IsVisible="{Binding HasRemovals}" />
        <ListBox Grid.Row="5" Classes="summary-list" ItemsSource="{Binding ToRemove}" MaxHeight="120"
                 IsVisible="{Binding HasRemovals}" />
    </Grid>

</UserControl>

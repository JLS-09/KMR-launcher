<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KMRLauncherMvvm.ViewModels"
        xmlns:controls="using:KMRLauncherMvvm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        Width="1400" Height="800" MinWidth="1000" MinHeight="600"
        x:Class="KMRLauncherMvvm.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Images/icon.png"
        Title="KMR Launcher"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource Inter}"
        FontSize="14">

    <Window.Styles>
        <Style Selector="StackPanel.status > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.status > TextBlock.sep">
            <Setter Property="Foreground" Value="{DynamicResource LineStrong}" />
        </Style>
        <Style Selector="StackPanel.status > controls|StrokeIcon">
            <Setter Property="Size" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A page built in idle time after startup: laid out once, never seen or clicked -->
        <Style Selector="ContentControl.warming">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="216, *">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0 0 1 0" Padding="12 16">
                <DockPanel>
                    <!-- Logo lockup; the flame follows the accent -->
                    <Viewbox DockPanel.Dock="Top" Width="160" Height="64" HorizontalAlignment="Left"
                             Margin="10 6 10 26" Stretch="Fill">
                        <Canvas Width="502" Height="200">
                            <Canvas RenderTransformOrigin="0,0">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="12" Y="-18" />
                                </Canvas.RenderTransform>
                                <Canvas RenderTransformOrigin="0,0">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1.91" ScaleY="1.91" />
                                            <TranslateTransform X="-53.5" Y="16.72" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <Path Fill="{DynamicResource TextPrimary}" Data="{StaticResource LogoRocketBody}" />
                                    <Path Fill="{DynamicResource TextPrimary}" Data="{StaticResource LogoRocketWindow}" />
                                    <Path Fill="{DynamicResource Accent}" Data="{StaticResource LogoFlame}" />
                                </Canvas>
                                <Path Fill="{DynamicResource TextPrimary}" Data="{StaticResource LogoKmr}" />
                                <Path Fill="{DynamicResource TextSecondary}" Data="{StaticResource LogoLauncher}" />
                            </Canvas>
                        </Canvas>
                    </Viewbox>

                    <!-- Bottom: the primary instance, or the game that is running -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0 1 0 0"
                            Padding="4 14 4 2">
                        <StackPanel Spacing="8">
                            <Panel>
                                <StackPanel Spacing="8" IsVisible="{Binding IsRunning}">
                                    <Grid ColumnDefinitions="Auto, Auto, *">
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource StatusFits}"
                                                 VerticalAlignment="Center" Margin="0 0 8 0" />
                                        <TextBlock Grid.Column="1" Classes="label fitsText" Text="RUNNING"
                                                   LineHeight="16" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="mono secondary size12" LineHeight="17.4"
                                                   Text="{Binding RunningTime}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Classes="size13 medium" Text="{Binding RunningInstanceName}"
                                               LineHeight="18.85" TextTrimming="CharacterEllipsis" />
                                    <Grid ColumnDefinitions="*, 6, *">
                                        <Border Grid.Column="0" Background="Transparent"
                                                ToolTip.Tip="Logs come in Phase 8. Until then the game's output goes to the console.">
                                            <Button Classes="secondary small" HorizontalAlignment="Stretch"
                                                    IsHitTestVisible="False" Focusable="False">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <controls:StrokeIcon Data="{StaticResource IconTerminal}" Size="14"
                                                                         VerticalAlignment="Center" />
                                                    <TextBlock Text="Log" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Button x:Name="StopButton" Grid.Column="2" Classes="secondary small"
                                                HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:StrokeIcon Data="{StaticResource IconStop}" Size="14"
                                                                     IsFilled="True" VerticalAlignment="Center" />
                                                <TextBlock Text="Stop" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="TopEdgeAlignedLeft">
                                                    <StackPanel Width="260" Spacing="12">
                                                        <TextBlock Classes="size14 semibold" TextWrapping="Wrap"
                                                                   Text="{Binding RunningInstanceName, StringFormat='Stop {0}?'}" />
                                                        <TextBlock Classes="size12 secondary" TextWrapping="Wrap"
                                                                   Text="KSP is closed right away. Anything you haven't saved in the game is lost." />
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    HorizontalAlignment="Right">
                                                            <Button Classes="ghost small" Content="Cancel"
                                                                    Click="CloseStopFlyout" />
                                                            <Button Classes="danger small" Content="Stop"
                                                                    Click="ConfirmStop" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Idle: primary instance on the left, a Launch button on the right -->
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" IsVisible="{Binding !IsRunning}">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                                                IsVisible="{Binding HasPrimaryInstance}">
                                        <TextBlock Classes="label" Text="PRIMARY" LineHeight="16" />
                                        <TextBlock Classes="size13 medium"
                                                   Text="{Binding PrimaryInstance.Name, FallbackValue=''}"
                                                   LineHeight="18.85" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="mono muted size11" LineHeight="16"
                                                   Text="{Binding PrimaryInstance.Version, StringFormat='KSP {0}', FallbackValue=''}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="accent icon" BorderThickness="0" CornerRadius="8"
                                            VerticalAlignment="Center" IsVisible="{Binding HasPrimaryInstance}"
                                            Command="{Binding LaunchPrimaryCommand}"
                                            ToolTip.Tip="{Binding PrimaryInstance.Name, StringFormat='Launch {0}', FallbackValue=''}">
                                        <controls:StrokeIcon Data="{StaticResource IconPlay}" Size="16" IsFilled="True"
                                                             Foreground="{DynamicResource OnAccent}" />
                                    </Button>

                                    <!-- No instances (not in the mockups) -->
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Spacing="8"
                                                IsVisible="{Binding !HasPrimaryInstance}">
                                        <TextBlock Classes="muted size13" Text="No instances yet" />
                                        <Button Classes="secondary small" HorizontalAlignment="Stretch"
                                                Command="{Binding GoToInstancesCommand}" Content="Go to Instances" />
                                    </StackPanel>
                                </Grid>
                            </Panel>
                            <!-- Only when launching failed (not in the mockups) -->
                            <TextBlock Classes="size12 errorText" Text="{Binding LaunchError}" TextWrapping="Wrap"
                                       IsVisible="{Binding LaunchError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Border>

                    <Button DockPanel.Dock="Bottom" Classes="nav" Classes.active="{Binding SettingsPageIsActive}"
                            Command="{Binding GoToSettingsCommand}" Margin="0 28 0 20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:StrokeIcon Data="{StaticResource IconSettings}" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="4">
                        <Button Classes="nav" Classes.active="{Binding HomePageIsActive}"
                                Command="{Binding GoToHomeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:StrokeIcon Data="{StaticResource IconHome}" VerticalAlignment="Center" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding DiscoverPageIsActive}"
                                Command="{Binding GoToDiscoverCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <controls:StrokeIcon Data="{StaticResource IconDiscover}" VerticalAlignment="Center" />
                                <TextBlock Text="Discover" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding InstancesPageIsActive}"
                                Command="{Binding GoToInstancesCommand}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <controls:StrokeIcon Grid.Column="0" Data="{StaticResource IconInstances}"
                                                     VerticalAlignment="Center" Margin="0 0 12 0" />
                                <TextBlock Grid.Column="1" Text="Instances" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="mono muted size11"
                                           Text="{Binding InstanceCount}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Top bar and page -->
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *">
                <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0 0 0 1" Padding="28 16">
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="h1" Text="{Binding PageTitle}" VerticalAlignment="Center" />
                        <!-- Searches only the current page for now; read-only on pages it can't search yet -->
                        <TextBox Grid.Column="1" x:Name="SearchBox" Classes="search" Width="400"
                                 Text="{Binding SearchText}" PlaceholderText="Search mods, instances and actions"
                                 IsReadOnly="{Binding !CanSearch}" ToolTip.Tip="{Binding SearchHint}">
                            <TextBox.InnerLeftContent>
                                <controls:StrokeIcon Data="{StaticResource IconSearch}" Size="16" Margin="10 0 8 0"
                                                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            </TextBox.InnerLeftContent>
                            <TextBox.InnerRightContent>
                                <Border Classes="kbd" Margin="8 0 10 0">
                                    <TextBlock Text="Ctrl K" />
                                </Border>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <!-- Only on Home and Discover, like the mockups -->
                        <Button Grid.Column="2" Classes="secondary icon" IsVisible="{Binding ShowFetchButton}"
                                Command="{Binding FetchCkanMetaCommand}" ToolTip.Tip="Fetch CKAN-meta now">
                            <controls:StrokeIcon Data="{StaticResource IconRefresh}" Size="16" />
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource ErrorBox}" BorderBrush="{DynamicResource ErrorBoxLine}"
                        BorderThickness="0 0 0 1" Padding="28 10" IsVisible="{Binding HasSettingsProblem}">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <controls:StrokeIcon Grid.Column="0" Data="{StaticResource IconWarning}" Size="16"
                                             Foreground="{DynamicResource StatusError}" VerticalAlignment="Center" />
                        <TextBlock Classes="size13" Grid.Column="1" Text="{Binding SettingsProblem}" LineHeight="19"
                                   TextWrapping="Wrap" Foreground="{DynamicResource ErrorBoxText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="ghost icon small" VerticalAlignment="Center"
                                Command="{Binding DismissSettingsProblemCommand}" ToolTip.Tip="Hide">
                            <controls:StrokeIcon Data="{StaticResource IconClose}" Size="14" />
                        </Button>
                    </Grid>
                </Border>
                <!-- Visited pages stay built; only the active one is shown, so switching pages is instant.
                     Discover and Instances are built in idle time after startup (WarmUpAsync). -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Panel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageViewModel">
                            <ContentControl Content="{Binding}" IsVisible="{Binding IsShown}"
                                            Classes.warming="{Binding IsWarming}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0 1 0 0" MinHeight="30" Padding="16 4">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Classes="status" Orientation="Horizontal" Spacing="8">
                    <controls:StrokeIcon Data="{StaticResource IconBranch}" />
                    <TextBlock Text="CKAN-meta" />
                    <TextBlock Classes="mono" Text="{Binding StatusBar.RepoText}" />
                    <TextBlock Classes="sep" Text="|" />
                    <TextBlock Text="{Binding StatusBar.VersionsText}" />
                    <TextBlock Classes="sep" Text="|" />
                    <!-- Placeholder: the time of the last sync is saved by the startup work (Phase 6 task 1) -->
                    <TextBlock Text="{Binding StatusBar.SyncText}" ToolTip.Tip="{Binding StatusBar.SyncHint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="status" Orientation="Horizontal" Spacing="8">
                    <controls:StrokeIcon Data="{StaticResource IconDownload}" />
                    <!-- Installs are modal for now, so nothing downloads while this is visible -->
                    <TextBlock Text="Downloads idle" />
                    <TextBlock Classes="sep" Text="|" />
                    <controls:StrokeIcon Data="{StaticResource IconDrive}" />
                    <TextBlock Text="{Binding StatusBar.CacheText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dialogs over the whole window (install flow, new instance), each over the one before it: scrim, then
             the dialog at most its own size (DialogHost); it shrinks with the window -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Dialogs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Panel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DialogHost">
                    <Panel Background="{DynamicResource Scrim}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64*" MinHeight="24" MaxHeight="64" />
                                <RowDefinition Height="860*" MaxHeight="{Binding Height}" />
                                <RowDefinition Height="64*" MinHeight="24" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="24" />
                                <ColumnDefinition Width="1080*" MaxWidth="{Binding Width}" />
                                <ColumnDefinition Width="*" MinWidth="24" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Content}" />
                        </Grid>
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>

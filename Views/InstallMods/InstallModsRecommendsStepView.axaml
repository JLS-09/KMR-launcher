<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
             xmlns:models="clr-namespace:KMRLauncherMvvm.Models"
             x:DataType="vm:InstallModsRecommendsStepViewModel"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="600"
             x:Class="KMRLauncherMvvm.Views.InstallMods.InstallModsRecommendsStepView">

    <!-- Step 2 "Extras" (mockup Wiz2Extras): recommended, suggested and supporting mods with a version each.
         Styles come from InstallDialogView. -->
    <UserControl.Styles>
        <Style Selector="Button.allNone">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8 0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Border.extraRow">
            <Setter Property="Padding" Value="6 8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.extraRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHover}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:VersionListItemViewModel">
            <Border Classes="row">
                <Border Classes="extraRow">
                    <Grid ColumnDefinitions="24, *, Auto" ColumnSpacing="12">
                        <CheckBox Classes="box native" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="rowName" Text="{Binding Identifier}" />
                                <TextBlock Classes="size11 muted"
                                           VerticalAlignment="Center" Text="{Binding ExtraDependenciesText}"
                                           IsVisible="{Binding ExtraDependenciesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <TextBlock Classes="rowHint" Text="{Binding SourcesText}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" Classes="version" VerticalAlignment="Center"
                                  ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ModVersion">
                                    <TextBlock Text="{Binding Version}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel Spacing="18">
        <TextBlock Classes="size13 secondary" LineHeight="20" TextWrapping="Wrap"
                   Text="Mods that go well with what you picked. Recommendations are ticked, suggestions are not. Anything you tick counts as picked by you." />

        <StackPanel IsVisible="{Binding ShowRecommendations}">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" ColumnSpacing="10" Margin="0 0 0 6">
                <TextBlock Classes="label" Text="RECOMMENDED" />
                <TextBlock Grid.Column="1" Classes="count" Text="{Binding Recommendations.Count}" />
                <Button Grid.Column="3" Classes="ghost allNone" Content="All" Margin="0 0 -8 0"
                        Command="{Binding SelectAllCommand}" CommandParameter="{Binding Recommendations}" />
                <Button Grid.Column="4" Classes="ghost allNone" Content="None"
                        Command="{Binding UnselectAllCommand}" CommandParameter="{Binding Recommendations}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Recommendations}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowSuggestions}">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" ColumnSpacing="10" Margin="0 0 0 6">
                <TextBlock Classes="label" Text="SUGGESTED" />
                <TextBlock Grid.Column="1" Classes="count" Text="{Binding Suggestions.Count}" />
                <Button Grid.Column="3" Classes="ghost allNone" Content="All" Margin="0 0 -8 0"
                        Command="{Binding SelectAllCommand}" CommandParameter="{Binding Suggestions}" />
                <Button Grid.Column="4" Classes="ghost allNone" Content="None"
                        Command="{Binding UnselectAllCommand}" CommandParameter="{Binding Suggestions}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Suggestions}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowSupported}">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" ColumnSpacing="10" Margin="0 0 0 6">
                <TextBlock Classes="label" Text="SUPPORTS YOUR PICKS" />
                <TextBlock Grid.Column="1" Classes="count" Text="{Binding Supported.Count}" />
                <Button Grid.Column="3" Classes="ghost allNone" Content="All" Margin="0 0 -8 0"
                        Command="{Binding SelectAllCommand}" CommandParameter="{Binding Supported}" />
                <Button Grid.Column="4" Classes="ghost allNone" Content="None"
                        Command="{Binding UnselectAllCommand}" CommandParameter="{Binding Supported}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Supported}" />
        </StackPanel>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
             xmlns:models="clr-namespace:KMRLauncherMvvm.Models"
             x:DataType="vm:InstallModsRecommendsStepViewModel"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             Background="#1F1F20"
             Foreground="{DynamicResource PrimaryText}"
             x:Class="KMRLauncherMvvm.Views.InstallMods.InstallModsRecommendsStepView">

    <UserControl.Styles>
        <Style Selector="Button.selection">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        </Style>

        <Style Selector="Button.selection:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.selection:focus /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        </Style>

        <Style Selector="Button.select:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryGreen}" />
        </Style>

        <Style Selector="Button.unselect:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryRed}" />
        </Style>

        <Style Selector="Button.mod-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.mod-row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.mod-row:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.mod-row-border">
            <Setter Property="Background" Value="{DynamicResource SideBarBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.mod-row-border.selected">
            <Setter Property="Background"
                    Value="{DynamicResource SideBarButtonActiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryGreen}" />
        </Style>

        <Style Selector="ListBox.mod-list">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.mod-list > ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.mod-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.mod-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:VersionListItemViewModel">
            <Border Padding="8 4" BorderThickness="2 0 0 0" Classes="mod-row-border"
                    Classes.selected="{Binding IsSelected}">
                <Grid ColumnDefinitions="* Auto" ColumnSpacing="16">
                    <Button Grid.Column="0" Classes="mod-row" Padding="0"
                            Command="{Binding $parent[UserControl].((vm:InstallModsRecommendsStepViewModel)DataContext).ToggleRecommendationCommand}"
                            CommandParameter="{Binding}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Identifier}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SourcesText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </Button>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersion}"
                              IsVisible="{Binding HasMultipleVersions}"
                              VerticalAlignment="Center" MinWidth="120"
                              CornerRadius="0" FontSize="13">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ModVersion">
                                <TextBlock Text="{Binding Version}" FontSize="13" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.Version}"
                               IsVisible="{Binding !HasMultipleVersions}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryText}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Margin="32 0 32 0" RowDefinitions="Auto Auto Auto *">
        <!-- Row 0 was the progress bar; it lives in InstallModsWindow now -->
        <Grid Grid.Row="1" Margin="0 32 0 0" RowDefinitions="Auto *" RowSpacing="8"
              IsVisible="{Binding ShowRecommendations}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto Auto" ColumnSpacing="16">
                <TextBlock Grid.Column="0" Text="RECOMMENDED MODS" LetterSpacing="1"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SelectAllCommand}"
                            CommandParameter="{Binding Recommendations}"
                            Classes="select selection">
                        <TextBlock Text="Select All" LetterSpacing="1"
                                   FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    </Button>
                    <TextBlock Text="/" LetterSpacing="1"
                               Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    <Button Command="{Binding UnselectAllCommand}"
                            CommandParameter="{Binding Recommendations}"
                            Classes="unselect selection">
                        <TextBlock Text="Unselect All" LetterSpacing="1"
                                   FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
            <ListBox Grid.Row="1" Classes="mod-list" ItemsSource="{Binding Recommendations}" MaxHeight="200" />
        </Grid>
        <Grid Grid.Row="2" Margin="0 32 0 0" RowDefinitions="Auto *" RowSpacing="8"
              IsVisible="{Binding ShowSuggestions}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto Auto" ColumnSpacing="16">
                <TextBlock Grid.Column="0" Text="SUGGESTED MODS" LetterSpacing="1"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SelectAllCommand}"
                            CommandParameter="{Binding Suggestions}"
                            Classes="select selection">
                        <TextBlock Text="Select All" LetterSpacing="1"
                                   FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    </Button>
                    <TextBlock Text="/" LetterSpacing="1"
                               Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    <Button Command="{Binding UnselectAllCommand}"
                            CommandParameter="{Binding Suggestions}"
                            Classes="unselect selection">
                        <TextBlock Text="Unselect All" LetterSpacing="1"
                                   FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
            <ListBox Grid.Row="1" Classes="mod-list" ItemsSource="{Binding Suggestions}" MaxHeight="200" />
        </Grid>
        <Grid Grid.Row="3" Margin="0 32 0 0" RowDefinitions="Auto *" RowSpacing="8"
              IsVisible="{Binding ShowSupported}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto Auto" ColumnSpacing="16">
                <TextBlock Grid.Column="0" Text="SUPPORTED BY" LetterSpacing="1"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SelectAllCommand}"
                            CommandParameter="{Binding Supported}"
                            Classes="select selection">
                        <TextBlock Text="Select All" LetterSpacing="1"
                                   FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    </Button>
                    <TextBlock Text="/" LetterSpacing="1"
                               Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    <Button Command="{Binding UnselectAllCommand}"
                            CommandParameter="{Binding Supported}"
                            Classes="unselect selection">
                        <TextBlock Text="Unselect All" LetterSpacing="1"
                                   FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
            <ListBox Grid.Row="1" Classes="mod-list" ItemsSource="{Binding Supported}" />
        </Grid>
    </Grid>

</UserControl>
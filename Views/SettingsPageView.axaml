<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1224" d:DesignHeight="800"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels"
             xmlns:settings="clr-namespace:KMRLauncherMvvm.ViewModels.Settings"
             xmlns:controls="using:KMRLauncherMvvm.Controls"
             xmlns:models="clr-namespace:KMRLauncherMvvm.Models"
             x:DataType="vm:SettingsPageViewModel"
             x:Class="KMRLauncherMvvm.Views.SettingsPageView"
             Foreground="{DynamicResource TextPrimary}">

    <UserControl.Styles>
        <Style Selector="Button.sectionNav">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12 0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style
            Selector="Button.sectionNav:pointerover /template/ ContentPresenter, Button.sectionNav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.sectionNav.active">
            <Setter Property="Background" Value="{DynamicResource NavActive}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style
            Selector="Button.sectionNav.active:pointerover /template/ ContentPresenter, Button.sectionNav.active:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActive}" />
        </Style>

        <Style Selector="Border.zipRow">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="8 4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.zipRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHover}" />
        </Style>
        <Style Selector="StackPanel.repoState Ellipse">
            <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="StackPanel.repoState TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="StackPanel.repoState.fits Ellipse">
            <Setter Property="Fill" Value="{DynamicResource StatusFits}" />
        </Style>
        <Style Selector="StackPanel.repoState.fits TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusFits}" />
        </Style>
        <Style Selector="StackPanel.repoState.failed Ellipse">
            <Setter Property="Fill" Value="{DynamicResource StatusError}" />
        </Style>
        <Style Selector="StackPanel.repoState.failed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusError}" />
        </Style>
        <Style Selector="TextBlock.fieldValue">
            <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="UniformGrid.repoFields">
            <Setter Property="Columns" Value="4" />
        </Style>
        <Style Selector=":is(UserControl).stacked UniformGrid.repoFields">
            <Setter Property="Columns" Value="2" />
        </Style>
        <Style Selector="StackPanel.found">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.found TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusFits}" />
        </Style>
        <Style Selector="StackPanel.found controls|StrokeIcon">
            <Setter Property="Foreground" Value="{DynamicResource StatusFits}" />
        </Style>
        <Style Selector="RadioButton.swatch">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Ring" Width="36" Height="36" CornerRadius="18" BorderThickness="2"
                            BorderBrush="Transparent" Background="Transparent" Padding="3">
                        <Ellipse Fill="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.swatch:checked /template/ Border#Ring">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.missing">
            <Setter Property="Foreground" Value="{DynamicResource StatusWarning}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="230, *">
        <Border Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0 0 1 0" Padding="12 20">
            <StackPanel Spacing="2">
                <Button Name="KspNav" Classes="sectionNav active" Content="KSP versions"
                        Click="SectionNav_OnClick" />
                <Button Name="ReposNav" Classes="sectionNav" Content="Mod repositories"
                        Click="SectionNav_OnClick" />
                <Button Name="DownloadsNav" Classes="sectionNav" Content="Downloads and cache"
                        Click="SectionNav_OnClick" />
                <Button Name="LaunchingNav" Classes="sectionNav" Content="Launching"
                        Click="SectionNav_OnClick" />
                <Button Name="AppearanceNav" Classes="sectionNav" Content="Appearance"
                        Click="SectionNav_OnClick" />
                <Button Name="AboutNav" Classes="sectionNav" Content="About"
                        Click="SectionNav_OnClick" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Name="Scroller" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="Scroller_OnScrollChanged">
            <Grid Name="SectionsHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="960" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="28 8 28 32">
                    <StackPanel Name="KspSection" Classes="settingsSection first">
                        <TextBlock Classes="h2 sectionTitle" Text="KSP versions" />
                        <TextBlock Classes="secondary size13" LineHeight="20.15" TextWrapping="Wrap"
                                   Margin="0 0 0 12"
                                   Text="New instances are created from these zips. The version is read from the build ID inside the zip." />
                        <ItemsControl ItemsSource="{Binding KspZips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:KspZipRow">
                                    <Border Classes="zipRow">
                                        <Grid ColumnDefinitions="72, *, 72, 32" ColumnSpacing="12">
                                            <TextBlock Grid.Column="0" Classes="mono size13 medium"
                                                       VerticalAlignment="Center" Text="{Binding Version}" />
                                            <TextBlock Grid.Column="1" Classes="mono secondary size12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding PathText}" ToolTip.Tip="{Binding Path}" />
                                            <TextBlock Grid.Column="2" Classes="mono muted" FontSize="12"
                                                       Classes.missing="{Binding IsMissing}"
                                                       VerticalAlignment="Center" TextAlignment="Right"
                                                       Text="{Binding SizeText}" />
                                            <Button Grid.Column="3" Classes="ghost small icon" CornerRadius="8"
                                                    HorizontalAlignment="Right"
                                                    AutomationProperties.Name="{Binding RemoveLabel}"
                                                    ToolTip.Tip="Remove from the list. The zip file stays where it is."
                                                    Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).RemoveKspZipCommand}"
                                                    CommandParameter="{Binding}">
                                                <controls:StrokeIcon Data="{StaticResource IconTrash}" Size="16" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="zipRow" IsVisible="{Binding HasNoZips}">
                            <TextBlock Classes="muted size13" VerticalAlignment="Center"
                                       Text="No KSP zips yet. Add one to create instances from it." />
                        </Border>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 1 0 0" Padding="0 12 0 14">
                            <StackPanel Spacing="8">
                                <Button Classes="secondary" HorizontalAlignment="Left" Click="AddKspZip_OnClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:StrokeIcon Data="{StaticResource IconPlus}" Size="16"
                                                             VerticalAlignment="Center" />
                                        <TextBlock Text="Add KSP zip" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Classes="size12 errorText" TextWrapping="Wrap"
                                           Text="{Binding AddZipError}"
                                           IsVisible="{Binding AddZipError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Classes="sectionLine" />
                    <StackPanel Name="ReposSection" Classes="settingsSection">
                        <TextBlock Classes="h2 sectionTitle" Text="Mod repositories" />
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 1 0 0" Padding="0 16">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto" ColumnSpacing="10">
                                    <TextBlock Classes="size14 semibold" Grid.Column="0"
                                               VerticalAlignment="Center" Text="CKAN-meta" />
                                    <Border Grid.Column="1" Classes="chip plain" VerticalAlignment="Center"
                                            ToolTip.Tip="Priorities matter once more repositories can be added (Phase 8)">
                                        <TextBlock Classes="mono" Text="Priority 1" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Classes="repoState" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center" Background="Transparent"
                                                Classes.fits="{Binding IsUpToDate}"
                                                Classes.failed="{Binding IsFetchFailed}"
                                                ToolTip.Tip="{Binding RepoStateHint}">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                                        <TextBlock Classes="size12" VerticalAlignment="Center"
                                                   Text="{Binding RepoStateText}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Classes="secondary small"
                                            Command="{Binding FetchNowCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:StrokeIcon Data="{StaticResource IconRefresh}" Size="14"
                                                                 VerticalAlignment="Center" />
                                            <TextBlock Text="Fetch now" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="5" Classes="secondary small icon" CornerRadius="8"
                                            AutomationProperties.Name="Open local copy" ToolTip.Tip="Open local copy"
                                            Command="{Binding OpenLocalCopyCommand}">
                                        <controls:StrokeIcon Data="{StaticResource IconFolder}" Size="16" />
                                    </Button>
                                </Grid>
                                <UniformGrid Classes="repoFields" ColumnSpacing="12" RowSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="label" Text="URL" />
                                        <TextBlock Classes="fieldValue" Text="{Binding RepoUrlText}"
                                                   ToolTip.Tip="{Binding RepoUrlText}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="label" Text="BRANCH" />
                                        <TextBlock Classes="fieldValue" Text="{Binding BranchText}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="label" Text="LAST FETCH" />
                                        <TextBlock Classes="fieldValue" Text="{Binding LastFetchText}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="label" Text="LOCAL COPY" />
                                        <TextBlock Classes="fieldValue" Text="{Binding LocalCopyText}"
                                                   ToolTip.Tip="{Binding LocalCopyText}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Classes="size12 errorText" TextWrapping="Wrap"
                                           Text="{Binding FetchError}"
                                           IsVisible="{Binding FetchError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="size12 errorText" TextWrapping="Wrap"
                                           Text="{Binding OpenError}"
                                           IsVisible="{Binding OpenError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Fetch on startup" />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <ToggleButton Classes="switch" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Fetch on startup"
                                                  IsChecked="{Binding FetchOnStartup}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Offline" />
                                </StackPanel>
                                <Border Classes="rowValue soon" ToolTip.Tip="Offline handling comes in Phase 7 (task 4)">
                                    <StackPanel Classes="rowControls">
                                        <ToggleButton Classes="switch" IsChecked="True" />
                                        <TextBlock Classes="muted size12" VerticalAlignment="Center"
                                                   Text="Use the cached list when a fetch fails" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="More repositories" />
                                    <TextBlock Classes="rowHint"
                                               Text="Mods with the same identifier come from the repository with the highest priority." />
                                </StackPanel>
                                <Border Classes="rowValue soon" ToolTip.Tip="More repositories come in Phase 8">
                                    <Button Classes="secondary">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:StrokeIcon Data="{StaticResource IconPlus}" Size="16"
                                                                 VerticalAlignment="Center" />
                                            <TextBlock Text="Add repository" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Classes="sectionLine" />
                    <StackPanel Name="DownloadsSection" Classes="settingsSection">
                        <TextBlock Classes="h2 sectionTitle" Text="Downloads and cache" />
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Parallel downloads" />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <TextBox Classes="field mono" Width="80" FontSize="13"
                                             AutomationProperties.Name="Parallel downloads"
                                             Text="{Binding ParallelDownloads, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Classes="muted size12" VerticalAlignment="Center"
                                               Text="1 to 16" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Cache folder" />
                                    <TextBlock Classes="rowHint"
                                               Text="Downloads are checked against their hash before they are cached." />
                                </StackPanel>
                                <StackPanel Classes="rowValue" Spacing="6">
                                    <StackPanel Classes="rowControls">
                                        <TextBlock Classes="mono secondary size12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding CacheFolderText}" />
                                        <Button Classes="secondary small" Command="{Binding OpenCacheFolderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:StrokeIcon Data="{StaticResource IconFolder}" Size="14"
                                                                     VerticalAlignment="Center" />
                                                <TextBlock Text="Open" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Cache size" />
                                </StackPanel>
                                <Grid Classes="rowValue">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="520" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <Border Height="8" CornerRadius="4" ClipToBounds="True"
                                                Background="{DynamicResource Off}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding InUseWidth}" />
                                                    <ColumnDefinition Width="{Binding UnusedWidth}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource TextSecondary}" />
                                                <Border Grid.Column="1" Background="{DynamicResource StatusWarning}" />
                                            </Grid>
                                        </Border>
                                        <WrapPanel ItemSpacing="16" LineSpacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource TextSecondary}" />
                                                <TextBlock Classes="secondary size12" Text="In use" />
                                                <TextBlock Classes="mono secondary size12" Text="{Binding InUseText}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource StatusWarning}" />
                                                <TextBlock Classes="secondary size12" Text="Not used by any instance" />
                                                <TextBlock Classes="mono secondary size12" Text="{Binding UnusedText}" />
                                            </StackPanel>
                                            <TextBlock Classes="mono muted size12" Text="{Binding ArchivesText}" />
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Name="RemoveUnusedButton" Classes="secondary small"
                                                    Content="Remove unused" IsEnabled="{Binding HasUnused}">
                                                <Button.Flyout>
                                                    <Flyout Placement="TopEdgeAlignedLeft">
                                                        <StackPanel Width="300" Spacing="12">
                                                            <TextBlock Classes="size14 semibold"
                                                                       Text="Remove unused downloads?" />
                                                            <TextBlock Classes="secondary size12" TextWrapping="Wrap"
                                                                       Text="{Binding RemoveUnusedText}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                                        HorizontalAlignment="Right">
                                                                <Button Classes="ghost small" Content="Cancel"
                                                                        Click="CloseCacheFlyouts" />
                                                                <Button Classes="danger small" Content="Remove"
                                                                        Click="ConfirmRemoveUnused" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Name="ClearCacheButton" Classes="ghost small" Content="Clear all"
                                                    IsEnabled="{Binding HasArchives}">
                                                <Button.Flyout>
                                                    <Flyout Placement="TopEdgeAlignedLeft">
                                                        <StackPanel Width="300" Spacing="12">
                                                            <TextBlock Classes="size14 semibold"
                                                                       Text="Clear the download cache?" />
                                                            <TextBlock Classes="secondary size12" TextWrapping="Wrap"
                                                                       Text="{Binding ClearAllText}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                                        HorizontalAlignment="Right">
                                                                <Button Classes="ghost small" Content="Cancel"
                                                                        Click="CloseCacheFlyouts" />
                                                                <Button Classes="danger small" Content="Clear all"
                                                                        Click="ConfirmClearCache" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="size12 errorText"
                                                   TextWrapping="Wrap" Text="{Binding CacheError}"
                                                   IsVisible="{Binding CacheError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Classes="sectionLine" />
                    <StackPanel Name="LaunchingSection" Classes="settingsSection">
                        <TextBlock Classes="h2 sectionTitle" Text="Launching" />
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Default runner" />
                                    <TextBlock Classes="rowHint" Text="For new instances. Each instance can change it." />
                                </StackPanel>
                                <WrapPanel Classes="rowValue">
                                    <Border Classes="segmented raised">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <RadioButton Classes="segment big" GroupName="defaultRunner" Content="Wine"
                                                         IsChecked="True" />
                                            <Border Classes="soon" ToolTip.Tip="Proton comes in Phase 8">
                                                <RadioButton Classes="segment big" GroupName="defaultRunnerSoon"
                                                             Content="Proton (umu-run)" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Wine" />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <TextBlock Classes="mono secondary size12" VerticalAlignment="Center"
                                               Text="{Binding WinePathText}" IsVisible="{Binding WineFound}" />
                                    <StackPanel Classes="found" IsVisible="{Binding WineFound}">
                                        <controls:StrokeIcon Data="{StaticResource IconCheck}" Size="13"
                                                             VerticalAlignment="Center" />
                                        <TextBlock Classes="size12" VerticalAlignment="Center" Text="found" />
                                    </StackPanel>
                                    <TextBlock Classes="size12 errorText" VerticalAlignment="Center"
                                               IsVisible="{Binding !WineFound}"
                                               Text="wine wasn't found on your PATH. Install Wine to launch KSP." />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="umu-run" />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <TextBlock Classes="mono secondary size12" VerticalAlignment="Center"
                                               Text="{Binding UmuPathText}" IsVisible="{Binding UmuFound}" />
                                    <StackPanel Classes="found" IsVisible="{Binding UmuFound}">
                                        <controls:StrokeIcon Data="{StaticResource IconCheck}" Size="13"
                                                             VerticalAlignment="Center" />
                                        <TextBlock Classes="size12" VerticalAlignment="Center" Text="found" />
                                    </StackPanel>
                                    <TextBlock Classes="muted size12" VerticalAlignment="Center"
                                               IsVisible="{Binding !UmuFound}"
                                               Text="not found · only needed for Proton (Phase 8)" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Default Proton" />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <Border Classes="soon" ToolTip.Tip="Proton comes in Phase 8">
                                        <Button Classes="secondary" MinWidth="240" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                <TextBlock Text="GE-Proton (latest)" VerticalAlignment="Center" />
                                                <controls:StrokeIcon Grid.Column="1" Data="{StaticResource IconChevronDown}"
                                                                     Size="16" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Wine debug output" />
                                    <TextBlock Classes="rowHint"
                                               Text="Sets WINEDEBUG. Errors only keeps crash info in the game's console output." />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <Button Classes="secondary" MinWidth="240" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding WineDebugText}" VerticalAlignment="Center" />
                                            <controls:StrokeIcon Grid.Column="1" Data="{StaticResource IconChevronDown}"
                                                                 Size="16" VerticalAlignment="Center" />
                                        </Grid>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                <MenuItem Header="Off"
                                                          Command="{Binding SetWineDebugCommand}"
                                                          CommandParameter="{x:Static models:WineDebugLevel.Off}" />
                                                <MenuItem Header="Errors only"
                                                          Command="{Binding SetWineDebugCommand}"
                                                          CommandParameter="{x:Static models:WineDebugLevel.ErrorsOnly}" />
                                                <MenuItem Header="Errors and fixmes"
                                                          Command="{Binding SetWineDebugCommand}"
                                                          CommandParameter="{x:Static models:WineDebugLevel.WineDefault}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Classes="sectionLine" />
                    <StackPanel Name="AppearanceSection" Classes="settingsSection">
                        <TextBlock Classes="h2 sectionTitle" Text="Appearance" />
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Accent color" />
                                    <TextBlock Classes="rowHint" Text="Try them: this page follows your pick." />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="settings:AccentSwatch">
                                                <RadioButton Classes="swatch" GroupName="accent"
                                                             Background="{Binding Brush}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             AutomationProperties.Name="{Binding Name}"
                                                             ToolTip.Tip="{Binding Name}"
                                                             Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).PickAccentCommand}"
                                                             CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="muted size12" VerticalAlignment="Center"
                                               Text="{Binding AccentName}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Density" />
                                    <TextBlock Classes="rowHint" Text="Compact fits more rows in the mod lists." />
                                </StackPanel>
                                <WrapPanel Classes="rowValue">
                                    <Border Classes="soon" ToolTip.Tip="Compact density comes later (Phase 9)">
                                        <Border Classes="segmented raised">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <RadioButton Classes="segment big" GroupName="density"
                                                             Content="Comfortable" IsChecked="True" />
                                                <RadioButton Classes="segment big" GroupName="density"
                                                             Content="Compact" />
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Classes="sectionLine" />
                    <StackPanel Name="AboutSection" Classes="settingsSection">
                        <TextBlock Classes="h2 sectionTitle" Text="About" />
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Version" />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <TextBlock Classes="mono size12" VerticalAlignment="Center"
                                               Text="{Binding VersionText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Source" />
                                </StackPanel>
                                <StackPanel Classes="rowValue rowControls">
                                    <Button Classes="link" VerticalAlignment="Center" ToolTip.Tip="Open on GitHub"
                                            Command="{Binding OpenSourceCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding SourceText}" VerticalAlignment="Center" />
                                            <controls:StrokeIcon Data="{StaticResource IconExternal}" Size="13"
                                                                 VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settingsRow">
                            <Grid Classes="settingsGrid" ColumnDefinitions="220, *" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="24">
                                <StackPanel Classes="rowLabel">
                                    <TextBlock Classes="rowTitle" Text="Data folder" />
                                </StackPanel>
                                <StackPanel Classes="rowValue" Spacing="6">
                                    <StackPanel Classes="rowControls">
                                        <TextBlock Classes="mono secondary size12" VerticalAlignment="Center"
                                                   Text="{Binding DataFolderText}" />
                                        <Button Classes="secondary small" Command="{Binding OpenDataFolderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:StrokeIcon Data="{StaticResource IconFolder}" Size="14"
                                                                     VerticalAlignment="Center" />
                                                <TextBlock Text="Open" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Classes="size12 errorText"
                                               TextWrapping="Wrap" Text="{Binding AboutError}"
                                               IsVisible="{Binding AboutError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

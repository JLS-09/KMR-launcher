<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
             xmlns:models="clr-namespace:KMRLauncherMvvm.Models"
             xmlns:controls="clr-namespace:KMRLauncherMvvm.Controls"
             x:DataType="vm:InstallModsSummaryStepViewModel"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="600"
             x:Class="KMRLauncherMvvm.Views.InstallMods.InstallModsSummaryStepView">

    <!-- Step 4 "Review" (mockup Wiz4Review): tiles, the problems box and every change. Styles come from
         InstallDialogView. -->
    <StackPanel Spacing="18">
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 1" ClipToBounds="True">
            <UniformGrid Rows="1" Margin="-1 0 0 0">
                <Border Classes="tile">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="NEW" />
                        <TextBlock Classes="tileValue" Text="{Binding NewText}" />
                    </StackPanel>
                </Border>
                <Border Classes="tile">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="UPDATES" />
                        <TextBlock Classes="tileValue" Text="{Binding UpdatesText}" />
                    </StackPanel>
                </Border>
                <Border Classes="tile">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="REMOVED" />
                        <TextBlock Classes="tileValue" Text="{Binding RemovedText}" />
                    </StackPanel>
                </Border>
                <Border Classes="tile">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="TO DOWNLOAD" />
                        <TextBlock Classes="tileValue" Text="{Binding ToDownloadText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- No problems -->
        <Border Padding="14 10" CornerRadius="9" Background="{DynamicResource OkBox}"
                BorderBrush="{DynamicResource FitsRowLine}" BorderThickness="1" IsVisible="{Binding !HasProblems}">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                <controls:StrokeIcon Data="{StaticResource IconCheck}" Size="14" VerticalAlignment="Center"
                                     Foreground="{DynamicResource StatusFits}" />
                <TextBlock Classes="size13" Grid.Column="1" TextWrapping="Wrap" Text="{Binding OkText}" />
            </Grid>
        </Border>

        <!-- Problems (block Install) -->
        <Border Padding="14 10" CornerRadius="9" Background="{DynamicResource StatusErrorSoft}"
                BorderBrush="{DynamicResource StatusErrorLine}" BorderThickness="1" IsVisible="{Binding HasProblems}">
            <ItemsControl ItemsSource="{Binding Problems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ResolutionProblem">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <controls:StrokeIcon Data="{StaticResource IconWarning}" Size="14" VerticalAlignment="Top"
                                                 Margin="0 2 0 0" Foreground="{DynamicResource StatusError}" />
                            <TextBlock Classes="size13" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Message}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Classes="size13 secondary" IsVisible="{Binding HasNothingToDo}"
                   Text="Nothing to install or remove: everything you picked is installed already." />

        <StackPanel IsVisible="{Binding !HasNothingToDo}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 0 0 6">
                <TextBlock Classes="label" Text="{Binding RowsTitle}" />
                <TextBlock Classes="count" Text="{Binding Rows.Count}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChangeRow">
                        <Border Classes="row" Padding="4 8">
                            <Grid ColumnDefinitions="62, *, *, 80" ColumnSpacing="12">
                                <Border Classes="action" HorizontalAlignment="Left"
                                        Classes.new="{Binding IsNew}" Classes.update="{Binding IsUpdate}"
                                        Classes.remove="{Binding IsRemove}">
                                    <TextBlock Text="{Binding KindText}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="rowName" Text="{Binding Name}" />
                                    <TextBlock Classes="rowHint" Text="{Binding Reason}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Classes="version">
                                    <Run Text="{Binding Version}" />
                                    <Run Text="{Binding ReplacesText}" Foreground="{DynamicResource TextMuted}" />
                                </TextBlock>
                                <TextBlock Grid.Column="3" Classes="version" TextAlignment="Right"
                                           Text="{Binding SizeText}" IsVisible="{Binding !ShowCached}" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right" IsVisible="{Binding ShowCached}">
                                    <controls:StrokeIcon Data="{StaticResource IconDownload}" Size="12"
                                                         VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Classes="version" Foreground="{DynamicResource TextMuted}" Text="cached" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
             xmlns:visualBasic="clr-namespace:Microsoft.VisualBasic;assembly=Microsoft.VisualBasic.Core"
             x:DataType="vm:InstallModsRecommendsStepViewModel"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             Background="#1F1F20"
             Foreground="{DynamicResource PrimaryText}"
             x:Class="KMRLauncherMvvm.Views.InstallMods.InstallModsRecommendsStepView">

    <Grid Margin="32 32 32 0" RowDefinitions="Auto * *" RowSpacing="32">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="INSTALL MODS" FontSize="30" FontFamily="{DynamicResource SpaceMonoBold}"
                       LetterSpacing="1.5" HorizontalAlignment="Left" />
            <Grid ColumnDefinitions="* * * *" ColumnSpacing="8">
                <Rectangle Grid.Column="0" Height="4" Fill="{DynamicResource PrimaryRed}" />
                <Rectangle Grid.Column="1" Height="4" Fill="{DynamicResource PrimaryRed}" />
                <Rectangle Grid.Column="2" Height="4" Fill="{DynamicResource PrimaryBackground}" />
                <Rectangle Grid.Column="3" Height="4" Fill="{DynamicResource PrimaryBackground}" />
            </Grid>
        </StackPanel>
        <Grid Grid.Row="1" RowDefinitions="Auto *" RowSpacing="8" IsVisible="{Binding ShowRecommendations}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto Auto" ColumnSpacing="16">
                <TextBlock Grid.Column="0" Text="RECOMMENDED MODS" LetterSpacing="1"
                           Foreground="{DynamicResource SecondaryText}"
                           FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SelectAllCommand}"
                            CommandParameter="{Binding Recommendations}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>

                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryGreen}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="Select All" LetterSpacing="1"
                                   FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12"/>
                    </Button>
                    <TextBlock Text="/" LetterSpacing="1"
                               Foreground="{DynamicResource SecondaryText}"
                               FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12"/>
                    <Button Command="{Binding UnselectAllCommand}"
                            CommandParameter="{Binding Recommendations}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>

                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryRed}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="Unselect All" LetterSpacing="1"
                                   FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0" Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.Styles>
                        <Style Selector="Button.mod-row">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="16" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                        <Style Selector="Button.mod-row:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="Button.mod-row:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ItemsControl.Styles>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="mod-row"
                                    Command="{Binding $parent[ItemsControl].((vm:InstallModsRecommendsStepViewModel)DataContext).ToggleRecommendationCommand}"
                                    CommandParameter="{Binding}">
                                <Button.Theme>
                                    <ControlTheme TargetType="Button">
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </ControlTemplate>
                                        </Setter>
                                    </ControlTheme>
                                </Button.Theme>
                                <Border Padding="8 4" BorderThickness="2 0 0 0"
                                        Classes.selected="{Binding IsSelected}">
                                    <Border.Styles>
                                        <Style Selector="Border">
                                            <Setter Property="Background" Value="{DynamicResource SideBarBackground}" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Border.selected">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SideBarButtonActiveBackground}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryGreen}" />
                                        </Style>
                                    </Border.Styles>
                                    
                                    <TextBlock Text="{Binding Version.Identifier}" />
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" RowDefinitions="Auto *" RowSpacing="8" IsVisible="{Binding ShowSuggestions}">
            <TextBlock Grid.Row="0" Text="SUGGESTED MODS" LetterSpacing="1" Foreground="{DynamicResource SecondaryText}" 
                       FontFamily="{DynamicResource SpaceMonoBold}" FontSize="12" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{Binding Suggestions}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Version.Identifier}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
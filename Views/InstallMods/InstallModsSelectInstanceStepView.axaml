<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
             xmlns:models="clr-namespace:KMRLauncherMvvm.Models"
             xmlns:controls="clr-namespace:KMRLauncherMvvm.Controls"
             x:DataType="vm:InstallModsSelectInstanceStepViewModel"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="600"
             x:Class="KMRLauncherMvvm.Views.InstallMods.InstallModsSelectInstanceStepView">

    <!-- Step 1 (mockup Wiz1Instance): instance cards with a fit hint, then the changes. Styles come from
         InstallDialogView. -->
    <StackPanel Spacing="18">
        <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="10">
            <TextBlock Classes="label" Text="INSTALL INTO" />
            <TextBlock Grid.Column="1" Classes="count" Text="{Binding InstancesCountText}" />
            <Button Grid.Column="3" Classes="ghost small" Command="{Binding NewInstanceCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:StrokeIcon Data="{StaticResource IconPlus}" Size="14" VerticalAlignment="Center" />
                    <TextBlock Text="New instance" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" ColumnSpacing="10" RowSpacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InstanceCardViewModel">
                    <RadioButton Classes="dot card" GroupName="installTarget" IsChecked="{Binding IsSelected}">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Name}" />
                                <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                           Text="{Binding KspText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <controls:StrokeIcon Data="{StaticResource IconCheck}" Size="12" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource StatusFits}" IsVisible="{Binding Fits}" />
                                <controls:StrokeIcon Data="{StaticResource IconPackage}" Size="12" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TextSecondary}"
                                                     IsVisible="{Binding IsInstalled}" />
                                <controls:StrokeIcon Data="{StaticResource IconWarning}" Size="12" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource StatusWarning}"
                                                     IsVisible="{Binding IsWarning}" />
                                <Panel VerticalAlignment="Center">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource StatusFits}"
                                               Text="{Binding FitText}" IsVisible="{Binding Fits}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                               Text="{Binding FitText}" IsVisible="{Binding IsInstalled}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource StatusWarning}"
                                               Text="{Binding FitText}" IsVisible="{Binding IsWarning}" />
                                </Panel>
                            </StackPanel>
                        </Grid>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- No instances yet -->
        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                   IsVisible="{Binding HasNoInstances}"
                   Text="There are no instances yet. Create one with New instance to install into it." />

        <StackPanel IsVisible="{Binding HasChanges}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 0 0 6">
                <TextBlock Classes="label" Text="CHANGES" />
                <TextBlock Classes="count" Text="{Binding Changes.Count}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Changes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChangeRow">
                        <Border Classes="row" Padding="4 9">
                            <Grid ColumnDefinitions="62, *, Auto" ColumnSpacing="12">
                                <Border Classes="action" HorizontalAlignment="Left"
                                        Classes.new="{Binding IsNew}" Classes.update="{Binding IsUpdate}"
                                        Classes.remove="{Binding IsRemove}">
                                    <TextBlock Text="{Binding KindText}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="rowName" Text="{Binding Name}" />
                                    <TextBlock Classes="rowHint" Text="{Binding Reason}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Classes="version" Text="{Binding ChangeText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="row" Padding="4 10"
                    IsVisible="{Binding ChoicesHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:StrokeIcon Data="{StaticResource IconClock}" Size="14" VerticalAlignment="Center"
                                         Foreground="{DynamicResource StatusWarning}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource StatusWarning}" TextWrapping="Wrap"
                               Text="{Binding ChoicesHint}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Problems (block Next) -->
        <Border Padding="14 10" CornerRadius="9" Background="{DynamicResource StatusErrorSoft}"
                BorderBrush="{DynamicResource StatusErrorLine}" BorderThickness="1" IsVisible="{Binding HasProblems}">
            <ItemsControl ItemsSource="{Binding Problems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ResolutionProblem">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <controls:StrokeIcon Data="{StaticResource IconWarning}" Size="14" VerticalAlignment="Top"
                                                 Margin="0 2 0 0" Foreground="{DynamicResource StatusError}" />
                            <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="{Binding Message}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>

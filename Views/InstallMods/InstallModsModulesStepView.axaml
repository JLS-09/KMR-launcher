<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels.InstallMods"
             xmlns:models="clr-namespace:KMRLauncherMvvm.Models"
             xmlns:controls="clr-namespace:KMRLauncherMvvm.Controls"
             x:DataType="vm:InstallModsModulesStepViewModel"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="600"
             x:Class="KMRLauncherMvvm.Views.InstallMods.InstallModsModulesStepView">

    <!-- Step 3 "Choices" (mockup Wiz3Choices): one section per any_of / virtual module, then the choices that had
         only one option ("Picked for you"). Styles come from InstallDialogView. -->
    <UserControl.Styles>
        <Style Selector="RadioButton.dot.option">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="RadioButton.dot.option:checked">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <Style Selector="RadioButton.dot.option:pointerover:unchecked">
            <Setter Property="Background" Value="{DynamicResource RowHover}" />
        </Style>
        <Style Selector="Border.smallChip">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="8 0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Control}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.smallChip TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="18">
        <TextBlock FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                   Text="Some mods need one of several mods. Pick one for each." />

        <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="18" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChoiceGroupViewModel">
                    <Border Classes="row" Padding="0 18 0 4">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <Border Classes="smallChip" IsVisible="{Binding IsVirtual}">
                                        <TextBlock Text="virtual" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="rowHint" Text="{Binding RequiredByText}" />
                            </StackPanel>
                            <TextBlock FontSize="13" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding HelpText}" IsVisible="{Binding HasHelpText}" />
                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource StatusError}"
                                       Text="{Binding ErrorText}" IsVisible="{Binding IsUnsatisfiable}" />
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChoiceOptionViewModel">
                                        <RadioButton Classes="dot option" IsChecked="{Binding IsSelected}"
                                                     GroupName="{Binding $parent[ItemsControl].((vm:ChoiceGroupViewModel)DataContext).Title}">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="rowName" Text="{Binding Identifier}" />
                                                        <Border Classes="smallChip" IsVisible="{Binding IsCached}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <controls:StrokeIcon Data="{StaticResource IconDownload}"
                                                                                     Size="11" VerticalAlignment="Center"
                                                                                     Foreground="{DynamicResource TextSecondary}" />
                                                                <TextBlock Text="cached" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="rowHint" Text="{Binding DescriptionText}"
                                                               IsVisible="{Binding DescriptionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" Classes="version" VerticalAlignment="Center"
                                                          ItemsSource="{Binding Versions}"
                                                          SelectedItem="{Binding SelectedVersion}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ModVersion">
                                                            <TextBlock Text="{Binding Version}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Choices with one option, picked without asking -->
        <Border Classes="row" Padding="0 18 0 4" IsVisible="{Binding HasPickedForYou}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:StrokeIcon Data="{StaticResource IconCheck}" Size="14" VerticalAlignment="Center"
                                         Foreground="{DynamicResource StatusFits}" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Picked for you" />
                    <TextBlock Classes="count" Text="{Binding PickedForYou.Count}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding PickedForYou}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PickedForYouRow">
                            <WrapPanel ItemSpacing="8">
                                <TextBlock Classes="mono" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Text="{Binding Need}" />
                                <controls:StrokeIcon Data="{StaticResource IconArrowRight}" Size="12"
                                                     VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Classes="mono" FontSize="12" VerticalAlignment="Center" Text="{Binding Picked}" />
                                <TextBlock FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMuted}" Text="{Binding Why}" />
                            </WrapPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Problems (block Next) -->
        <Border Padding="14 10" CornerRadius="9" Background="{DynamicResource StatusErrorSoft}"
                BorderBrush="{DynamicResource StatusErrorLine}" BorderThickness="1" IsVisible="{Binding HasProblems}">
            <ItemsControl ItemsSource="{Binding InstallModsData.Problems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ResolutionProblem">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <controls:StrokeIcon Data="{StaticResource IconWarning}" Size="14" VerticalAlignment="Top"
                                                 Margin="0 2 0 0" Foreground="{DynamicResource StatusError}" />
                            <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="{Binding Message}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>

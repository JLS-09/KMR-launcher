<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KMRLauncherMvvm.ViewModels"
             xmlns:controls="using:KMRLauncherMvvm.Controls"
             x:DataType="vm:CompatibleVersionsViewModel"
             x:Class="KMRLauncherMvvm.Views.CompatibleVersionsView">
    <UserControl.Styles>
        <!-- Compatible KSP versions: rows of 52 / 120 / rest, padding 8 0, a line on top -->
        <Style Selector="Border.versionRow">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="Padding" Value="0 8" />
        </Style>
        <Style Selector="CheckBox.box.allVersions">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="CheckBox.box.allVersions /template/ Border#Box">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>
        <Style Selector="CheckBox.box.allVersions /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="8 0 0 0" />
        </Style>
        <Style Selector="CheckBox.box.allVersions:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <!-- Version chips: 30 px, padding 0 10, radius 7, 12 px mono; the game version is an accent chip with a lock -->
        <Style Selector="Border.versionChip">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10 0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
        </Style>
        <Style Selector="Border.versionChip.locked">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <Style Selector="CheckBox.box.versionBox">
            <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox.box.versionBox /template/ Border#Box">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="CheckBox.box.versionBox /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="6 0 0 0" />
        </Style>
        <Style Selector="CheckBox.box.versionBox:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="controls|StrokeIcon.flipped">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KspVersionGroupViewModel">
                    <Border Classes="versionRow">
                        <Grid ColumnDefinitions="52, 120, *" ColumnSpacing="12">
                            <TextBlock Classes="mono" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Text="{Binding Prefix}" />
                            <CheckBox Grid.Column="1" Classes="box allVersions"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AllowAll}" Content="{Binding AllowAllText}" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Versions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KspVersionOptionViewModel">
                                        <Panel>
                                            <Border Classes="versionChip" IsVisible="{Binding CanToggle}">
                                                <CheckBox Classes="box versionBox"
                                                          IsChecked="{Binding IsChecked}"
                                                          Content="{Binding Version}" />
                                            </Border>
                                            <Border Classes="versionChip locked"
                                                    IsVisible="{Binding IsInstanceVersion}"
                                                    ToolTip.Tip="The game version is always included">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <controls:StrokeIcon Data="{StaticResource IconLock}"
                                                                         Size="12" VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Classes="mono" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Version}" />
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0 1 0 0" Padding="0 10 0 12"
                IsVisible="{Binding HasOlderGroups}">
            <Button Classes="ghost small" HorizontalAlignment="Left" Command="{Binding ToggleOlderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding OlderToggleText}" VerticalAlignment="Center" />
                    <controls:StrokeIcon Data="{StaticResource IconChevronDown}" Size="14"
                                         VerticalAlignment="Center"
                                         Classes.flipped="{Binding ShowOlder}" />
                </StackPanel>
            </Button>
        </Border>
    </StackPanel>
</UserControl>
